// PropLink UK — full core schema (Sprint 1, Task 1.2).
// Geospatial (PostGIS) and full-text (tsvector) columns are Unsupported types;
// their indexes and triggers live in raw SQL migrations.
// Money convention: ALL *GBP fields are integer PENCE.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Authoritative application role, server-written only (never from the client).
/// LANDLORD: public sign-up (Phase 1 Task 2). SOLICITOR: Admin-created, one per
/// project (Phase 4). ADVERTISER: Admin-approved advertiser account (Phase 6).
/// ADMIN, AGENT, SOLICITOR and ADVERTISER can never be chosen at sign-up.
enum Role {
  AGENT
  INVESTOR
  BUYER
  ADMIN
  LANDLORD
  SOLICITOR
  ADVERTISER
}

/// What an INVESTOR may do on projects. One investor may hold both; the role on
/// a specific project (Lead or Co-Investor) is decided per project in Phase 4.
enum InvestorCapability {
  LEAD_INVESTOR
  CO_INVESTOR
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

/// KYC document kind — drives file-type allowlists and storage path prefix.
enum KycDocumentKind {
  PASSPORT
  DRIVERS_LICENCE
  NATIONAL_ID
  PROOF_OF_ADDRESS
  COMPANY_REGISTRATION
  OTHER
}

/// KYC submission lifecycle status (not the same as KycStatus on the profile).
/// DRAFT → SUBMITTED → (Admin reviews in Phase 5) APPROVED or REJECTED.
enum KycSubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvestorType {
  FLIPPER
  SYNDICATE
  BOTH
}

enum ListingSource {
  AGENT
  FLIPPER_RESALE
  INVESTOR_PROJECT
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  LIVE
  UNDER_OFFER
  SOLD
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  HMO
  LAND
}

enum EpcRating {
  A
  B
  C
  D
  E
  F
  G
}

enum DistressTag {
  SUBSIDENCE
  DAMP
  RENOVATION_NEEDED
  PROBATE
  ASBESTOS
  ROOF_REQUIRED
  WATER_DAMAGE
  FIRE_DAMAGE
}

enum SyndicateStatus {
  OPEN
  FUNDED
  IN_REFURB
  LISTED
  COMPLETED
}

enum PledgeStatus {
  PLEDGED
  CONFIRMED
  WITHDRAWN
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
}

enum LedgerType {
  EXPENSE
  CAPITAL_INJECTION
}

enum EnquiryStatus {
  NEW
  RESPONDED
  CLOSED
}

enum SubscriptionTier {
  STARTER
  PRO
  ELITE
}

enum OfferStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  UNDER_REVIEW
  COUNTER_OFFERED
  EXPIRED
}

enum DealStage {
  OFFER_ACCEPTED
  SOLICITOR_REFERRED
  CONVEYANCING
  EXCHANGED
  COMPLETED
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  DONE
  CANCELLED
}

enum PartnerCategory {
  INSURANCE
  CONVEYANCING
  STAGING
  TRADES
  SURVEYOR
  SOLICITOR
}

enum AdModel {
  CPM
  CPC
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?
  name           String
  role           Role
  emailVerified  DateTime?
  kycStatus      KycStatus @default(NOT_STARTED)
  complianceCode String?
  avatarUrl      String?
  gdprConsentAt  DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  agentProfiles     AgentProfile[]
  pledges           SyndicatePledge[]
  enquiries         Enquiry[]
  savedProperties   SavedProperty[]
  savedSearches     SavedSearch[]
  savedSearchAlerts SavedSearchAlert[]
  appraisals        Appraisal[]
  subscription      Subscription?
  offers            Offer[]
  viewings           Viewing[]
  sentMessages      ChatMessage[]     @relation("SentMessages")
  receivedMessages  ChatMessage[]     @relation("ReceivedMessages")
  kycRecords        KycRecord[]
  kycSubmissions    KycSubmission[]
  auditLogs         AuditLog[]
  ledgerEntries     LedgerEntry[]
  verificationTokens VerificationToken[]
  authProfile       Profile?

  flipperOpportunities FlipperOpportunity[]
  flipperOffers        FlipperOffer[]
  flipperAcquisitions  FlipperAcquisition[]
  flipperProjects      FlipperProject[]
  flipperResales       FlipperResale[]
}

/// Supabase Auth extension row. The UUID primary key is also a database-level
/// foreign key to auth.users(id), created in the raw SQL migration.
model Profile {
  id             String    @id @db.Uuid
  legacyUserId   String?   @unique
  role           Role      @default(BUYER)
  investorType   InvestorType?
  name           String?
  kycStatus      KycStatus @default(NOT_STARTED)
  complianceCode String?
  avatarUrl      String?
  gdprConsentAt  DateTime?
  active         Boolean   @default(true)
  /// Phase 1 Task 9 (ADR-028): sessions signed in before this are refused.
  sessionsRevokedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  legacyUser User? @relation(fields: [legacyUserId], references: [id], onDelete: SetNull)
  investorCapabilities InvestorCapabilityGrant[]
  agentInvitesCreated  AgentInvite[]             @relation("AgentInviteCreator")
  agentInvitesAccepted AgentInvite[]             @relation("AgentInviteAccepted")
  announcements        Announcement[]
  reviewsWritten       Review[]                  @relation("ReviewReviewer")
  reviewsReceived      Review[]                  @relation("ReviewSubject")
  reviewsModerated     Review[]                  @relation("ReviewModerator")
  reviewReports        ReviewReport[]            @relation("ReviewReporter")
  reviewReportsResolved ReviewReport[]           @relation("ReviewReportResolver")
  trackRecordSettings   TrackRecordSettings[]     @relation("TrackRecordSettingsEditor")
  adminGrants           AdminPermissionGrant[]    @relation("AdminGrantHolder")
  adminGrantRequestsFor AdminGrantRequest[]       @relation("AdminGrantTarget")
  adminGrantRequestsBy  AdminGrantRequest[]       @relation("AdminGrantRequester")
  adminGrantDecisions   AdminGrantRequest[]       @relation("AdminGrantDecider")
  casesAssigned         Case[]                    @relation("CaseAssignee")
  casesOpened           Case[]                    @relation("CaseOpener")
  casesResolved         Case[]                    @relation("CaseResolver")
  caseNotes             CaseNote[]                @relation("CaseNoteAuthor")
  caseEvidence          CaseEvidence[]            @relation("CaseEvidenceAdder")
  dataExportsAbout      DataExportRequest[]       @relation("DataExportSubject")
  dataExportsRequested  DataExportRequest[]       @relation("DataExportRequester")
  dataExportsDecided    DataExportRequest[]       @relation("DataExportDecider")
  companyCheck         AgentCompanyCheck?        @relation("AgentCompanyCheckProfile")
  companyOverrides     AgentCompanyCheck[]       @relation("AgentCompanyCheckOverrider")
  agentMigration       AgentMigration?           @relation("AgentMigrationProfile")
  migrationsNotified   AgentMigration[]          @relation("AgentMigrationNotifier")
  migrationsAuthorised AgentMigration[]          @relation("AgentMigrationAuthoriser")
  kycApplicant         KycApplicant?             @relation("KycApplicantProfile")
  verificationBadge    VerificationBadge?        @relation("VerificationBadgeProfile")
  badgesAwarded        VerificationBadge[]       @relation("VerificationBadgeAwarder")
  notificationPrefs    NotificationPreference[]  @relation("NotificationPreferenceProfile")
  mfaRecoveryCodes     MfaRecoveryCode[]         @relation("MfaRecoveryCodeProfile")
  mfaRecoverySessions  MfaRecoverySession[]      @relation("MfaRecoverySessionProfile")
  uploadedFiles        UploadedFile[]            @relation("UploadedFileOwner")
  userProfile          UserProfile?              @relation("UserProfileProfile")
  landlordListings     LandlordListing[]         @relation("LandlordListingOwner")
  landlordListingsMade LandlordListing[]         @relation("LandlordListingCreator")
  aiUsage              AiUsage[]                 @relation("AiUsageProfile")
  landlordListingsHeld LandlordListing[]         @relation("LandlordListingClaimer")
  listingReviewsMade   LandlordListingReview[]   @relation("LandlordListingReviewer")
  agentProposals       AgentProposal[]           @relation("AgentProposalAgent")
  proposalQuestions    AgentProposalQuestion[]   @relation("AgentProposalQuestionAsker")
  mandatesHeld         Mandate[]                 @relation("MandateAgent")
  mandatesEnded        Mandate[]                 @relation("MandateTerminator")
  disclosuresSet       MandateDisclosure[]       @relation("MandateDisclosureEditor")
  notificationsSent    NotificationDelivery[]    @relation("NotificationDeliveryProfile")
  plansCreated         SubscriptionPlan[]        @relation("SubscriptionPlanCreator")
  billingCustomer      BillingCustomer?          @relation("BillingCustomerProfile")
  billingSubscriptions BillingSubscription[]     @relation("SubscriptionProfile")
  chatThreadsAsA       ChatThread[]              @relation("ChatThreadParticipantA")
  chatThreadsAsB       ChatThread[]              @relation("ChatThreadParticipantB")
  chatAuthorizations   ChatAuthorization[]       @relation("ChatAuthorizationActor")
  chatMessagesSent     ChatThreadMessage[]       @relation("ChatThreadMessageSender")
  chatReportsMade      ChatReport[]              @relation("ChatReportReporter")
  chatReportsResolved  ChatReport[]              @relation("ChatReportResolver")
  projectsAsAgent      InvestorProject[]         @relation("InvestorProjectAgent")
  projectsAsLead       InvestorProject[]         @relation("InvestorProjectLead")
  projectsPublished    InvestorProject[]         @relation("InvestorProjectPublisher")
  projectInterests     ProjectInterest[]         @relation("ProjectInterestInvestor")
  leadNominations      ProjectLeadNomination[]   @relation("LeadNominationInvestor")
  leadNominationsMade  ProjectLeadNomination[]   @relation("LeadNominationNominator")
  leadNominationsDecided ProjectLeadNomination[] @relation("LeadNominationDecider")
  projectPledges       ProjectPledge[]           @relation("ProjectPledgeInvestor")
  projectFavourites    ProjectFavourite[]        @relation("ProjectFavouriteInvestor")
  projectQuestions     ProjectQuestion[]         @relation("ProjectQuestionAsker")
  projectAnswers       ProjectQuestion[]         @relation("ProjectQuestionAnswerer")
  projectQuestionsHidden ProjectQuestion[]       @relation("ProjectQuestionModerator")
  solicitorAppointment ProjectSolicitor?         @relation("ProjectSolicitorProfile")
  solicitorsInvited    ProjectSolicitor[]        @relation("ProjectSolicitorInviter")
  solicitorsEnded      ProjectSolicitor[]        @relation("ProjectSolicitorEnder")
  agreementsPrepared   ProjectAgreement[]        @relation("ProjectAgreementCreator")
  agreementParties     AgreementParty[]          @relation("AgreementPartyProfile")
  fundStatusesRecorded ProjectFundStatus[]       @relation("ProjectFundStatusRecorder")
  costsRecorded        ProjectCost[]             @relation("ProjectCostRecorder")
  costsVoided          ProjectCost[]             @relation("ProjectCostVoider")
  milestonesCreated    ProjectMilestone[]        @relation("ProjectMilestoneCreator")
  projectUpdates       ProjectUpdate[]           @relation("ProjectUpdateAuthor")
  changesRecorded      ProjectChange[]           @relation("ProjectChangeRecorder")
  changesDecided       ProjectChange[]           @relation("ProjectChangeDecider")
  salesRecorded        ProjectSale[]             @relation("ProjectSaleRecorder")
  salesConfirmed       ProjectSale[]             @relation("ProjectSaleConfirmer")
  ledgerEntries        DistributionLedgerEntry[] @relation("LedgerEntryParty")
  ledgerEntriesMade    DistributionLedgerEntry[] @relation("LedgerEntryActor")
  correctionsProposed  LedgerCorrection[]        @relation("LedgerCorrectionProposer")
  correctionsDecided   LedgerCorrection[]        @relation("LedgerCorrectionDecider")
  projectDecisions     ProjectDecision[]         @relation("ProjectDecisionMaker")
  retailListingsMade   ProjectRetailListing[]    @relation("ProjectRetailListingCreator")

  @@map("profiles")
}

/// Server-granted investor capabilities (Phase 1 Task 1). Rows are allowed only
/// for INVESTOR profiles (enforced by a trigger). Written by the server only;
/// all Data API privileges are revoked.
model InvestorCapabilityGrant {
  profileId  String             @db.Uuid
  capability InvestorCapability
  grantedAt  DateTime           @default(now())
  /// Admin profile that granted it; null for the migration backfill.
  grantedBy  String?            @db.Uuid

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, capability])
  @@map("investor_capabilities")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  purpose   String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AgentProfile {
  id                String  @id @default(cuid())
  userId            String
  agencyName        String
  bio               String?
  rating            Float   @default(0)
  verifiedDealCount Int     @default(0)
  complianceCode    String  @unique
  active            Boolean @default(true)

  user        User        @relation(fields: [userId], references: [id])
  properties  Property[]
  caseStudies CaseStudy[]
  appraisals  Appraisal[]

  @@index([userId])
}

model Property {
  id             String         @id @default(cuid())
  agentProfileId String?
  listingSource  ListingSource  @default(AGENT)
  title          String
  description    String
  status         PropertyStatus @default(DRAFT)
  addressLine1   String
  city           String
  region         String
  postcode       String
  /// PostGIS point; set via raw SQL from lat/lng. GIST-indexed in migration.
  location       Unsupported("geography(Point,4326)")?
  propertyType   PropertyType
  bedrooms       Int            @default(0)
  askingPriceGBP Int // pence
  targetRoiPct   Float?
  epcRating      EpcRating?
  epcCertUrl     String?
  floorPlanUrl   String?
  /// Agent's confirmation (Task 2.2 wizard step 3) that the seller has been
  /// advised the asking price may be revised after survey findings, and that
  /// any change will be disclosed to buyers before offers are accepted.
  /// Required before submitForReview; null while still drafting.
  pricingSafeguardAckAt DateTime?
  /// Task 2.6 analytics: incremented once per browser session per visitor by
  /// `POST /api/listings/[id]/view`; the owning agent's and admins' own views
  /// are never counted. Saves are not denormalised here — they are counted
  /// live from `SavedProperty`, which has no equivalent double-count problem.
  viewCount      Int            @default(0)
  /// Maintained by trigger in migration; GIN-indexed.
  searchVector   Unsupported("tsvector")?
  createdAt      DateTime       @default(now())
  /// Set by `transitionStatus` whenever a listing moves to PENDING_REVIEW —
  /// distinct from `createdAt` because a resubmission after a Task 2.3
  /// rejection must show the *new* submission date in the moderation queue.
  submittedAt    DateTime?
  publishedAt    DateTime?
  /// Admin's reason (Task 2.3 moderation) for the most recent reject back to
  /// DRAFT; cleared on approval. Null until a listing has been rejected once.
  rejectionReason String?

  agentProfile      AgentProfile?         @relation(fields: [agentProfileId], references: [id])
  resaleFor         FlipperResale?        @relation("ResaleProperty")
  distressTags      PropertyDistressTag[]
  images            PropertyImage[]
  syndicateProjects SyndicateProject[]
  enquiries         Enquiry[]
  savedBy           SavedProperty[]
  successFees       SuccessFee[]
  offers            Offer[]
  deals             Deal[]
  viewings          Viewing[]
  chatMessages      ChatMessage[]
  flipperOpportunities FlipperOpportunity[]
  flipperOffers        FlipperOffer[]
  flipperAcquisitions  FlipperAcquisition[]
  flipperProjects      FlipperProject[]
  flipperResales       FlipperResale[]
  retailProject        ProjectRetailListing?

  @@index([status])
  @@index([agentProfileId])
  @@index([postcode])
  @@index([city])
}

model PropertyDistressTag {
  propertyId String
  tag        DistressTag

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, tag])
}

model PropertyImage {
  id         String @id @default(cuid())
  propertyId String
  url        String
  sortOrder  Int    @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model SyndicateProject {
  id                      String          @id @default(cuid())
  propertyId              String
  name                    String
  capitalTargetGBP        Int // pence
  equityModelNotes        String?
  status                  SyndicateStatus @default(OPEN)
  capitalProtectionPolicy String?
  createdAt               DateTime        @default(now())

  property    Property          @relation(fields: [propertyId], references: [id])
  pledges     SyndicatePledge[]
  milestones  Milestone[]
  ledger      LedgerEntry[]
  successFees SuccessFee[]

  @@index([status])
  @@index([propertyId])
}

/// EOI mode: pledges record intent only — money NEVER moves (see docs/CONTEXT.md).
model SyndicatePledge {
  id             String       @id @default(cuid())
  projectId      String
  investorUserId String
  amountGBP      Int // pence
  status         PledgeStatus @default(PLEDGED)
  createdAt      DateTime     @default(now())

  project  SyndicateProject @relation(fields: [projectId], references: [id])
  investor User             @relation(fields: [investorUserId], references: [id])

  @@index([projectId])
  @@index([investorUserId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  notes       String?
  status      MilestoneStatus @default(PLANNED)
  completedAt DateTime?

  project SyndicateProject @relation(fields: [projectId], references: [id])
  photos  MilestonePhoto[]

  @@index([projectId])
}

model MilestonePhoto {
  id          String @id @default(cuid())
  milestoneId String
  url         String

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model LedgerEntry {
  id          String     @id @default(cuid())
  projectId   String
  type        LedgerType
  amountGBP   Int // pence
  description String
  createdBy   String
  createdAt   DateTime   @default(now())

  project SyndicateProject @relation(fields: [projectId], references: [id])
  author  User             @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([createdBy])
}

model Enquiry {
  id         String        @id @default(cuid())
  propertyId String
  fromUserId String
  message    String
  status     EnquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  from     User     @relation(fields: [fromUserId], references: [id])

  @@index([propertyId])
  @@index([fromUserId])
}

model SavedProperty {
  userId     String
  propertyId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
}

model SavedSearch {
  id            String  @id @default(cuid())
  userId        String
  name          String
  paramsJson    Json
  alertsEnabled Boolean @default(false)
  lastAlertAt   DateTime?
  /// Phase 5 Task 3 (ADR-056): unsubscribe links carry this random token.
  alertToken    String?   @unique
  createdAt     DateTime  @default(now())

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts SavedSearchAlert[]

  @@index([userId])
  @@index([alertsEnabled])
}

model CaseStudy {
  id             String  @id @default(cuid())
  agentProfileId String
  title          String
  capexGBP       Int // pence
  netMarginGBP   Int // pence
  description    String
  imageUrl       String?

  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id])

  @@index([agentProfileId])
}

model Appraisal {
  id             String   @id @default(cuid())
  agentProfileId String
  investorUserId String
  rating         Int // 1..5, checked in service layer
  review         String
  createdAt      DateTime @default(now())

  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id])
  investor     User         @relation(fields: [investorUserId], references: [id])

  @@unique([agentProfileId, investorUserId])
  @@index([investorUserId])
}

model Subscription {
  id               String           @id @default(cuid())
  agentUserId      String           @unique
  stripeCustomerId String?
  stripeSubId      String?
  tier             SubscriptionTier @default(STARTER)
  status           String           @default("inactive")
  listingLimit     Int              @default(3)

  agent User @relation(fields: [agentUserId], references: [id])
}

model SuccessFee {
  id         String   @id @default(cuid())
  propertyId String
  projectId  String?
  amountGBP  Int // pence
  vatGBP     Int // pence
  loggedAt   DateTime @default(now())

  property Property          @relation(fields: [propertyId], references: [id])
  project  SyndicateProject? @relation(fields: [projectId], references: [id])

  @@index([propertyId])
  @@index([projectId])
}

model Offer {
  id          String      @id @default(cuid())
  propertyId  String
  buyerUserId String
  amountGBP   Int // pence
  status      OfferStatus @default(SUBMITTED)
  createdAt   DateTime    @default(now())
  /// Phase 5 (ADR-053): the Agent's counter-offer, and when it lapses.
  counterAmountGBP Int?
  expiresAt   DateTime?
  updatedAt   DateTime    @default(now()) @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  buyer    User     @relation(fields: [buyerUserId], references: [id])
  deals    Deal[]
  events   OfferEvent[]

  @@index([propertyId])
  @@index([buyerUserId])
}

model Deal {
  id         String    @id @default(cuid())
  propertyId String
  offerId    String
  stage      DealStage @default(OFFER_ACCEPTED)
  updatedAt  DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  offer    Offer    @relation(fields: [offerId], references: [id])

  @@index([propertyId])
  @@index([offerId])
}

model Viewing {
  id          String        @id @default(cuid())
  propertyId  String
  buyerUserId String
  slotStart   DateTime
  slotEnd     DateTime
  status      ViewingStatus @default(REQUESTED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  buyer    User     @relation(fields: [buyerUserId], references: [id])
  events   ViewingEvent[]

  @@index([propertyId])
  @@index([buyerUserId])
}

model ChatMessage {
  id         String    @id @default(cuid())
  propertyId String
  fromUserId String
  toUserId   String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  from     User     @relation("SentMessages", fields: [fromUserId], references: [id])
  to       User     @relation("ReceivedMessages", fields: [toUserId], references: [id])

  @@index([propertyId])
  @@index([fromUserId])
  @@index([toUserId, readAt])
}

model Partner {
  id         String          @id @default(cuid())
  category   PartnerCategory
  name       String
  url        String
  logoUrl    String?
  approved   Boolean         @default(false)
  clickCount Int             @default(0)

  adSlots AdSlot[]
}

model AdSlot {
  id          String  @id @default(cuid())
  partnerId   String
  placement   String
  model       AdModel
  rateGBP     Int // pence
  active      Boolean @default(false)
  impressions Int     @default(0)
  clicks      Int     @default(0)

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

/// UK AML: retained 5 years — soft-delete only, survives user erasure (anonymised link).
model KycRecord {
  id                  String   @id @default(cuid())
  userId              String
  provider            String
  providerApplicantId String?
  status              String
  rawWebhookJson      Json?
  passportCountry     String?
  crn                 String?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Phase 4: Investor KYC submission (one per attempt). Transitions:
/// DRAFT (documents uploading) → SUBMITTED (investor confirms) →
/// APPROVED | REJECTED (Admin in Phase 5).
/// Financial KYC gating reads profiles.kycStatus, NOT this table.
model KycSubmission {
  id          String               @id @default(cuid())
  userId      String
  status      KycSubmissionStatus  @default(DRAFT)
  /// Investor's own declaration text — free form, required on submit.
  declaration String?
  submittedAt DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  /// Safe rejection reason visible to the Investor (Phase 5).
  rejectionReason  String?
  /// Admin-only confidential internal notes — NEVER exposed to Investor (Phase 5).
  internalNotes    String?
  /// Admin rejection reason legacy notes.
  reviewNotes      String?
  createdAt        DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  documents KycDocument[]

  @@index([userId, status])
  @@index([status, submittedAt])
}

/// Individual document uploaded within a KycSubmission.
/// storageKey is the private bucket key; the public URL is NEVER stored
/// — it must be generated server-side on demand with a signed URL.
model KycDocument {
  id           String          @id @default(cuid())
  submissionId String
  kind         KycDocumentKind
  /// Private bucket key, e.g. kyc/<userId>/<uuid>.pdf
  storageKey   String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime        @default(now())

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

/// Land Registry Price Paid ingest (Sprint 5).
model ComparableSale {
  id               String       @id @default(cuid())
  postcodeDistrict String
  address          String
  priceGBP         Int // pence
  soldDate         DateTime
  propertyType     PropertyType
  source           String       @default("LAND_REGISTRY")

  @@index([postcodeDistrict, soldDate])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entity      String
  entityId    String
  metaJson    Json?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entity, entityId])
  @@index([actorUserId])
}

enum FlipperOpportunityStatus {
  SAVED
  EVALUATING
  OFFER_SUBMITTED
  OFFER_ACCEPTED
  DECLINED
  WITHDRAWN
}

enum FlipperOfferStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum FlipperAcquisitionStatus {
  PENDING_COMPLETION
  COMPLETED
  CANCELLED
}

/// Phase 6: Property Flipper opportunity evaluation tracking.
model FlipperOpportunity {
  id             String                   @id @default(cuid())
  investorUserId String
  propertyId     String
  status         FlipperOpportunityStatus @default(SAVED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  investor User     @relation(fields: [investorUserId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  offers   FlipperOffer[]
  acquisitions FlipperAcquisition[]

  @@unique([investorUserId, propertyId])
  @@index([investorUserId, status])
  @@index([propertyId])
}

/// Phase 6: Property Flipper acquisition offer.
model FlipperOffer {
  id             String             @id @default(cuid())
  opportunityId String
  investorUserId String
  propertyId     String
  amountGBP      Int // pence
  status         FlipperOfferStatus @default(SUBMITTED)
  submittedAt    DateTime           @default(now())
  respondedAt    DateTime?
  agentNotes     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  opportunity FlipperOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  investor    User               @relation(fields: [investorUserId], references: [id])
  property    Property           @relation(fields: [propertyId], references: [id])
  acquisitions FlipperAcquisition[]

  @@index([opportunityId])
  @@index([investorUserId, status])
  @@index([propertyId, status])
}

/// Phase 6: Confirmed Flipper acquisition opportunity (handoff to Phase 7 Refurbishment).
model FlipperAcquisition {
  id             String                   @id @default(cuid())
  offerId        String                   @unique
  opportunityId String
  investorUserId String
  propertyId     String
  agreedPriceGBP Int // pence
  status         FlipperAcquisitionStatus @default(PENDING_COMPLETION)
  completedAt    DateTime?
  completedByUserId String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  offer       FlipperOffer       @relation(fields: [offerId], references: [id])
  opportunity FlipperOpportunity @relation(fields: [opportunityId], references: [id])
  investor    User               @relation(fields: [investorUserId], references: [id])
  property    Property           @relation(fields: [propertyId], references: [id])
  projects    FlipperProject[]

  @@index([investorUserId, status])
  @@index([propertyId])
}

enum FlipperProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum FlipperCostCategory {
  MATERIALS
  LABOUR
  PROFESSIONAL_FEES
  UTILITIES
  OTHER
}

enum FlipperMilestoneStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

/// Phase 7: Flipper refurbishment project tracking (unlocked after acquisition is COMPLETED).
model FlipperProject {
  id                   String               @id @default(cuid())
  acquisitionId        String               @unique
  investorUserId       String
  propertyId           String
  status               FlipperProjectStatus @default(PLANNING)
  plannedBudgetGBP     Int                  @default(0) // pence
  targetCompletionDate DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  acquisition FlipperAcquisition        @relation(fields: [acquisitionId], references: [id])
  investor    User                      @relation(fields: [investorUserId], references: [id])
  property    Property                  @relation(fields: [propertyId], references: [id])
  costs       FlipperProjectCost[]
  milestones  FlipperProjectMilestone[]
  resale      FlipperResale?

  @@index([investorUserId, status])
  @@index([propertyId])
}

/// Phase 7: Flipper project cost/expense ledger item.
model FlipperProjectCost {
  id          String              @id @default(cuid())
  projectId   String
  category    FlipperCostCategory @default(OTHER)
  description String
  amountGBP   Int // pence
  incurredAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project FlipperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
}

/// Phase 7: Flipper project milestone tracking.
model FlipperProjectMilestone {
  id          String                 @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      FlipperMilestoneStatus @default(TODO)
  targetDate  DateTime?
  completedAt DateTime?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project FlipperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// ─── Phase 8: Flipper Resale & Exit Workflow ──────────────────────────────────

/// Status lifecycle for Flipper resale listing.
/// DRAFT → SUBMITTED (by Investor) → APPROVED | REJECTED (by Admin only).
/// Investor can NEVER self-publish. LIVE is reached only via Admin approval.
enum FlipperResaleStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// Phase 8: Resale listing created by a Flipper investor after project completion.
/// The original FlipperProject is PRESERVED; this is a SEPARATE entity.
/// All financial figures labelled *Estimated* are non-guaranteed and advisory only.
/// Investor cannot transition to APPROVED directly; only Admin can.
model FlipperResale {
  id             String              @id @default(cuid())
  projectId      String              @unique
  investorUserId String
  propertyId     String

  /// Investor's estimated asking price for the renovated property (integer pence).
  estimatedAskingPriceGBP Int // pence — advisory, not guaranteed

  /// Investor's estimated profit margin (integer pence = estimated sale - total costs - acquisition price).
  /// Server-calculated from project data on submission; stored for audit trail.
  estimatedProfitGBP Int // pence — advisory

  /// Investor's resale listing description/pitch.
  description String?

  /// Investor's declaration confirming the listing information is accurate.
  declaration String?

  /// Admin-visible internal notes (NEVER exposed to Investor).
  internalNotes String?

  /// Safe reason shown to the Investor when the listing is rejected.
  rejectionReason String?

  status FlipperResaleStatus @default(DRAFT)

  resalePropertyId String?   @unique

  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        FlipperProject @relation(fields: [projectId], references: [id])
  investor       User           @relation(fields: [investorUserId], references: [id])
  property       Property       @relation(fields: [propertyId], references: [id])
  resaleProperty Property?      @relation("ResaleProperty", fields: [resalePropertyId], references: [id])

  @@index([investorUserId, status])
  @@index([status, submittedAt])
  @@index([propertyId])
}

/// Phase 1 Task 3 (ADR-023). Agent accounts are invitation-only.
enum AgentInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  /// Replaced by a newer invite to the same email (resend).
  SUPERSEDED
}

/// One Admin invitation for one email. The token itself is never stored, only
/// its SHA-256 hash. Server-only: RLS on, all Data API privileges revoked. At
/// most one PENDING invite per email (partial unique index in SQL).
model AgentInvite {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String
  tokenHash         String            @unique
  status            AgentInviteStatus @default(PENDING)
  expiresAt         DateTime
  usedAt            DateTime?
  createdBy         String            @db.Uuid
  createdAt         DateTime          @default(now())
  revokedAt         DateTime?
  acceptedProfileId String?           @db.Uuid
  termsAcceptedAt   DateTime?

  creator         Profile  @relation("AgentInviteCreator", fields: [createdBy], references: [id])
  acceptedProfile Profile? @relation("AgentInviteAccepted", fields: [acceptedProfileId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("agent_invites")
}

/// Phase 1 Task 3 (Q1). Admin-authored platform messages shown inside portals.
/// Plain text only, no links or third-party content; separate from paid
/// advertising (Phase 6).
enum AnnouncementKind {
  /// Promotional banner at the top of the dashboard.
  BANNER
  /// Platform update in the dashboard's updates list.
  UPDATE
}

model Announcement {
  id            String           @id @default(cuid())
  kind          AnnouncementKind
  title         String
  body          String
  audienceRoles Role[]
  startsAt      DateTime
  endsAt        DateTime?
  createdBy     String           @db.Uuid
  createdAt     DateTime         @default(now())
  archivedAt    DateTime?

  creator Profile @relation(fields: [createdBy], references: [id])

  @@index([startsAt])
  @@map("announcements")
}

/// Phase 1 Task 4 (ADR-024). Outcome of checking an Agent's company against
/// the Companies House register.
enum CompanyCheckResult {
  /// Found and `active` on the register.
  VERIFIED
  /// Found, but any other register status (dissolved, liquidation, ...).
  INACTIVE
}

/// Admin decision that replaces the automatic result.
enum CompanyCheckOverride {
  APPROVED
  REJECTED
}

/// One current company check per Agent profile. Written by the server only;
/// every check and override is also in the audit log.
model AgentCompanyCheck {
  profileId      String                @id @db.Uuid
  companyNumber  String
  /// Name and status exactly as the register returned them.
  companyName    String
  companyStatus  String
  result         CompanyCheckResult
  provider       String
  checkedAt      DateTime
  override       CompanyCheckOverride?
  overrideReason String?
  overriddenBy   String?               @db.Uuid
  overriddenAt   DateTime?
  updatedAt      DateTime              @updatedAt

  profile   Profile  @relation("AgentCompanyCheckProfile", fields: [profileId], references: [id], onDelete: Cascade)
  overrider Profile? @relation("AgentCompanyCheckOverrider", fields: [overriddenBy], references: [id])

  @@index([companyNumber])
  @@map("agent_company_checks")
}

/// Phase 1 Task 5 (ADR-025, business Q2). Agents who registered before
/// invite-only onboarding: notified, then they confirm, then Admin authorises.
enum AgentMigrationStatus {
  /// Emailed by Admin; the Agent has not confirmed yet.
  NOTIFIED
  /// The Agent confirmed their account; waiting for Admin.
  CONFIRMED
  /// Admin authorised the Agent for new features.
  AUTHORISED
}

/// One row per pre-invite Agent profile. Server-only; every step is audited.
model AgentMigration {
  profileId      String               @id @db.Uuid
  status         AgentMigrationStatus
  notifiedAt     DateTime?
  notifyCount    Int                  @default(0)
  lastNotifiedBy String?              @db.Uuid
  confirmedAt    DateTime?
  authorisedAt   DateTime?
  authorisedBy   String?              @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  profile    Profile  @relation("AgentMigrationProfile", fields: [profileId], references: [id], onDelete: Cascade)
  notifier   Profile? @relation("AgentMigrationNotifier", fields: [lastNotifiedBy], references: [id])
  authoriser Profile? @relation("AgentMigrationAuthoriser", fields: [authorisedBy], references: [id])

  @@index([status])
  @@map("agent_migrations")
}

/// Phase 1 Task 6 (ADR-026). One provider applicant per profile. Only
/// provider IDs and outcomes are stored: no documents, no raw payloads.
model KycApplicant {
  profileId     String    @id @db.Uuid
  provider      String
  applicantId   String
  /// Last provider decision: PENDING, APPROVED or REJECTED (null until one).
  outcome       String?
  rejectType    String?
  lastEventAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile Profile @relation("KycApplicantProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([provider, applicantId])
  @@map("kyc_applicants")
}

/// Phase 1 Task 6 (ADR-026). One row per accepted webhook delivery, keyed by
/// the SHA-256 of the exact raw body: a replay is a no-op. No payload stored.
model KycWebhookEvent {
  id          String   @id
  provider    String
  applicantId String
  type        String
  outcome     String?
  /// processed, ignored_unknown_applicant, ignored_stale or ignored_no_change.
  result      String
  occurredAt  DateTime
  receivedAt  DateTime @default(now())

  @@index([provider, applicantId])
  @@map("kyc_webhook_events")
}

/// Phase 1 Task 7 (ADR-027). Verified badge ("blue tick"). Present = shown.
/// Awarded and revoked by Admin only; every change is in the audit log.
model VerificationBadge {
  profileId String   @id @db.Uuid
  awardedAt DateTime @default(now())
  awardedBy String   @db.Uuid
  /// Why it was awarded, shown to Admins only.
  note      String?

  profile Profile @relation("VerificationBadgeProfile", fields: [profileId], references: [id], onDelete: Cascade)
  awarder Profile @relation("VerificationBadgeAwarder", fields: [awardedBy], references: [id])

  @@map("verification_badges")
}

/// Phase 1 Task 10 (ADR-029). A user's changes from the catalogue defaults
/// (src/services/notifications/catalogue.ts). No row = defaults.
model NotificationPreference {
  profileId String   @db.Uuid
  eventKey  String
  inApp     Boolean
  email     Boolean
  updatedAt DateTime @updatedAt

  profile Profile @relation("NotificationPreferenceProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, eventKey])
  @@map("notification_preferences")
}

/// Phase 1 Task 11 (ADR-030). Single-use MFA recovery codes; only a SHA-256
/// of the profile ID and the normalised code is stored.
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String    @db.Uuid
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  profile Profile @relation("MfaRecoveryCodeProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("mfa_recovery_codes")
}

/// Phase 1 Task 11 (ADR-030). A Supabase session that satisfied MFA with a
/// recovery code instead of an authenticator. Bound to that session only.
model MfaRecoverySession {
  sessionId String   @id
  profileId String   @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime

  profile Profile @relation("MfaRecoverySessionProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("mfa_recovery_sessions")
}

/// Phase 1 Task 12 (ADR-031). Lifecycle of an upload through the pipeline.
enum UploadStatus {
  /// In quarantine, not yet validated or scanned.
  QUARANTINED
  /// Scanned clean and promoted to private storage.
  AVAILABLE
  /// Declared type contradicted the file's bytes.
  REJECTED_TYPE
  /// The malware scanner flagged it.
  REJECTED_MALWARE
  /// The scanner failed; nothing was promoted.
  SCAN_FAILED
}

/// One uploaded file. The stored name is a UUID; the original name is
/// metadata only. Bytes live in the private object store, never public.
model UploadedFile {
  id              String       @id @db.Uuid
  ownerId         String       @db.Uuid
  purpose         String
  status          UploadStatus @default(QUARANTINED)
  originalName    String
  declaredType    String
  detectedType    String?
  sizeBytes       Int
  sha256          String
  storageKey      String
  scanSignature   String?
  previewable     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner Profile @relation("UploadedFileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  mandateContracts Mandate[] @relation("MandateTermsFile")
  chatAttachments ChatMessageAttachment[]

  @@index([ownerId, status])
  @@map("uploaded_files")
  agreementDrafts      ProjectAgreement[]        @relation("ProjectAgreementDraft")
  agreementsSigned     ProjectAgreement[]        @relation("ProjectAgreementSigned")
}

/// Admin-managed upload limits (single row, id = 1).
model UploadSettings {
  id             Int      @id @default(1)
  maxFileBytes   Int
  userQuotaBytes BigInt
  updatedAt      DateTime @updatedAt
  updatedBy      String?  @db.Uuid

  @@map("upload_settings")
}

/// Phase 1 Task 8 (ADR-032). Investor profile visibility (business Q4).
enum ProfileVisibility {
  /// Anonymous platform ID and general metrics only.
  PUBLIC
  /// Hidden; full details only to the project's Agent (Phase 4), self, Admin.
  PRIVATE
  /// Non-investors (TRD PR-3, owner choice 2026-11-18): signed-in members
  /// only. The default for Landlord, Agent and Buyer profiles.
  MEMBERS
}

/// LinkedIn-style profile for every account. Track record is computed by the
/// server and never stored here. Email and phone are never part of it.
model UserProfile {
  profileId   String            @id @db.Uuid
  /// Anonymous platform ID used in public URLs, e.g. PL-7K3M9Q2X.
  publicId    String            @unique
  headline    String?
  bio         String?
  location    String?
  specialisms String[]
  experience  String?
  photoFileId String?           @db.Uuid
  visibility  ProfileVisibility @default(PUBLIC)
  updatedAt   DateTime          @updatedAt

  profile Profile @relation("UserProfileProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Phase 2 Task 1 (ADR-034). Landlord listing lifecycle before mandates.
enum LandlordListingStatus {
  /// Being written by the Landlord (not visible to anyone else).
  DRAFT
  /// Created by an Admin on the Landlord's behalf; the Landlord must confirm.
  AWAITING_LANDLORD_CONFIRMATION
  /// In the Admin review queue (business Q6: 30-60 minutes).
  SUBMITTED
  /// Approved; visible to verified Agents only (TRD LL-3).
  APPROVED
  /// Sent back with a reason; the Landlord may edit and resubmit.
  REJECTED
  /// Withdrawn by the Landlord while no mandate existed (OD-22).
  WITHDRAWN
}

/// TRD LL-1 "property type": a property or development land.
enum LandlordPropertyKind {
  PROPERTY
  LAND
}

/// TRD LL-1 "desired outcome".
enum LandlordDesiredOutcome {
  REFURBISHMENT
  DEVELOPMENT_JV
}

/// TRD LL-1..LL-5. 100% private: never public, never in search/sitemaps,
/// never in investor or buyer views. Server-only table.
model LandlordListing {
  id              String                  @id @db.Uuid
  ownerId         String                  @db.Uuid
  createdBy       String                  @db.Uuid
  status          LandlordListingStatus   @default(DRAFT)
  title           String
  addressLine1    String?
  city            String?
  postcode        String?
  propertyKind    LandlordPropertyKind?
  propertyType    String?
  description     String?
  defects         String?
  requiredWork    String?
  /// Land area in whole square metres.
  landAreaSqm     Int?
  desiredOutcome  LandlordDesiredOutcome?
  rejectionReason String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?                 @db.Uuid
  withdrawnAt     DateTime?
  /// Admin holding the listing for review (Phase 2 Task 3); cleared when it leaves SUBMITTED.
  claimedBy       String?                 @db.Uuid
  claimedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  owner   Profile               @relation("LandlordListingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator Profile               @relation("LandlordListingCreator", fields: [createdBy], references: [id])
  claimer Profile?              @relation("LandlordListingClaimer", fields: [claimedBy], references: [id], onDelete: Restrict)
  files   LandlordListingFile[]
  reviews LandlordListingReview[]
  proposals AgentProposal[]
  mandates  Mandate[]
  projects  InvestorProject[]

  @@index([ownerId, status])
  @@index([status, submittedAt])
  @@index([claimedBy])
  @@map("landlord_listings")
}

/// What an attached file is for. Ownership documents are required (Q5).
enum LandlordListingFileKind {
  PHOTO
  DOCUMENT
  OWNERSHIP_DOCUMENT
}

/// Files attached to a landlord listing; the bytes live in the secure upload
/// pipeline (Phase 1 Task 12) and are served only via signed links.
model LandlordListingFile {
  listingId String                  @db.Uuid
  fileId    String                  @db.Uuid
  kind      LandlordListingFileKind
  createdAt DateTime                @default(now())

  listing LandlordListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, fileId])
  @@map("landlord_listing_files")
}

/// Lifecycle of one AI call's budget entry (Phase 2 Task 2, ADR-036).
enum AiUsageStatus {
  RESERVED
  COMPLETED
  FAILED
}

/// AI usage ledger: token counts only, never prompt or response text.
/// A row reserves the call's worst case against the daily budgets, then
/// records the actual usage.
model AiUsage {
  id             String        @id @db.Uuid
  profileId      String        @db.Uuid
  feature        String
  provider       String
  model          String
  status         AiUsageStatus @default(RESERVED)
  reservedTokens Int
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  profile Profile @relation("AiUsageProfile", fields: [profileId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([profileId, createdAt])
  @@map("ai_usage")
}

enum LandlordListingReviewDecision {
  APPROVED
  REJECTED
}

/// Append-only history of Admin review decisions (Phase 2 Task 3, ADR-037).
/// `submittedAt` is copied from the listing at decision time, so the SLA
/// history survives a reject-and-resubmit.
model LandlordListingReview {
  id          String                        @id @db.Uuid
  listingId   String                        @db.Uuid
  reviewerId  String                        @db.Uuid
  decision    LandlordListingReviewDecision
  reason      String?
  submittedAt DateTime
  decidedAt   DateTime                      @default(now())

  listing  LandlordListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  reviewer Profile         @relation("LandlordListingReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([decidedAt])
  @@index([listingId, decidedAt])
  @@map("landlord_listing_reviews")
}

enum AgentProposalStatus {
  SUBMITTED
  WITHDRAWN
  DECLINED
  SELECTED
}

enum AgentProposalFeeType {
  PERCENT
  FIXED
}

/// An Agent's structured proposal on an approved Landlord listing (Phase 2
/// Task 5, ADR-038). Money is integer pence.
model AgentProposal {
  id             String               @id @db.Uuid
  listingId      String               @db.Uuid
  agentId        String               @db.Uuid
  status         AgentProposalStatus  @default(SUBMITTED)
  valuationGBP   BigInt
  feeType        AgentProposalFeeType
  /// 150 = 1.5%, when feeType = PERCENT.
  feeBasisPoints Int?
  /// Pence, when feeType = FIXED.
  feeGBP         BigInt?
  contractMonths Int
  terms          String
  pitch          String
  submittedAt    DateTime             @default(now())
  withdrawnAt    DateTime?
  declinedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  listing   LandlordListing         @relation(fields: [listingId], references: [id], onDelete: Restrict)
  agent     Profile                 @relation("AgentProposalAgent", fields: [agentId], references: [id], onDelete: Restrict)
  questions AgentProposalQuestion[]
  mandates  Mandate[]

  @@unique([listingId, agentId])
  @@index([listingId, status])
  @@index([agentId])
  @@map("agent_proposals")
}

/// Structured Q&A on a proposal: the Landlord asks, the Agent answers once.
model AgentProposalQuestion {
  id         String    @id @db.Uuid
  proposalId String    @db.Uuid
  askedBy    String    @db.Uuid
  question   String
  answer     String?
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  proposal AgentProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  asker    Profile       @relation("AgentProposalQuestionAsker", fields: [askedBy], references: [id], onDelete: Restrict)

  @@index([proposalId, createdAt])
  @@map("agent_proposal_questions")
}

/// Exclusive mandate lifecycle (Phase 2 Task 6, ADR-039). OFFERED: the
/// Landlord chose this Agent's proposal; ACTIVE: the Agent accepted.
enum MandateStatus {
  OFFERED
  ACTIVE
  DECLINED
  WITHDRAWN
  TERMINATED
  CLOSED
}

/// Strictly exclusive (Q8): at most one OFFERED or ACTIVE mandate per listing
/// (partial unique index in the migration). Agreed terms are copied from the
/// chosen proposal and never change. Money is integer pence.
model Mandate {
  id                String               @id @db.Uuid
  listingId         String               @db.Uuid
  agentId           String               @db.Uuid
  proposalId        String               @db.Uuid
  status            MandateStatus        @default(OFFERED)
  valuationGBP      BigInt
  feeType           AgentProposalFeeType
  feeBasisPoints    Int?
  feeGBP            BigInt?
  contractMonths    Int
  terms             String
  renewalTerms      String?
  termsFileId       String?              @db.Uuid
  offeredAt         DateTime             @default(now())
  respondedAt       DateTime?
  acceptedAt        DateTime?
  /// acceptedAt + contractMonths: the Landlord may close the mandate from then.
  endsAt            DateTime?
  terminatedAt      DateTime?
  terminatedBy      String?              @db.Uuid
  terminationReason String?
  closedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  listing    LandlordListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  agent      Profile         @relation("MandateAgent", fields: [agentId], references: [id], onDelete: Restrict)
  proposal   AgentProposal   @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  terminator Profile?        @relation("MandateTerminator", fields: [terminatedBy], references: [id], onDelete: Restrict)
  termsFile  UploadedFile?   @relation("MandateTermsFile", fields: [termsFileId], references: [id], onDelete: Restrict)
  disclosure MandateDisclosure?
  project    InvestorProject?

  @@index([listingId, status])
  @@index([agentId, status])
  @@index([proposalId])
  @@map("mandates")
}

/// What investors will see of the Landlord's data when the mandated Agent
/// publishes (Phase 2 Task 7, ADR-040; TRD AG-7). Defaults hide the
/// Landlord's personal details; contact details and ownership documents have
/// no column because they are never exposable.
model MandateDisclosure {
  mandateId          String   @id @db.Uuid
  showLandlordName   Boolean  @default(false)
  showStreetAddress  Boolean  @default(false)
  showFullPostcode   Boolean  @default(false)
  showDescription    Boolean  @default(true)
  showDefects        Boolean  @default(true)
  showRequiredWork   Boolean  @default(true)
  showPhotos         Boolean  @default(true)
  showOtherDocuments Boolean  @default(false)
  updatedBy          String   @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mandate Mandate @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  editor  Profile @relation("MandateDisclosureEditor", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("mandate_disclosures")
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

/// Chain announcement deliveries (Phase 2 Task 8, ADR-041). Unique per
/// recipient, event, dedupe key and channel, so nobody is told the same thing
/// twice. Outcome only, never the message.
model NotificationDelivery {
  id        String                     @id @db.Uuid
  profileId String                     @db.Uuid
  eventKey  String
  dedupeKey String
  channel   String                     @default("email")
  status    NotificationDeliveryStatus @default(PENDING)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  profile Profile @relation("NotificationDeliveryProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, eventKey, dedupeKey, channel], map: "notification_deliveries_dedupe_key")
  @@index([createdAt])
  @@map("notification_deliveries")
}

/// Who pays (Clarification Answers §D): Agents, Lead Investors, Co-Investors.
enum SubscriptionAudience {
  AGENT
  LEAD_INVESTOR
  CO_INVESTOR
}

enum BillingInterval {
  MONTH
  YEAR
}

/// Mirrors the provider's subscription status (Stripe values, upper case).
enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

/// Admin-managed price (Phase 3 Task 1, ADR-042; OD-01). Provider prices are
/// immutable: a change retires this row and adds a new one.
model SubscriptionPlan {
  id              String               @id @db.Uuid
  audience        SubscriptionAudience
  interval        BillingInterval
  /// Pence.
  amountGBP       Int
  provider        String
  providerPriceId String               @unique
  active          Boolean              @default(true)
  createdBy       String               @db.Uuid
  createdAt       DateTime             @default(now())
  retiredAt       DateTime?

  creator Profile @relation("SubscriptionPlanCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("subscription_plans")
}

/// Singleton (id = 1): grace period after a failed payment.
model BillingSettings {
  id        Int      @id @default(1)
  graceDays Int      @default(7)
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@map("billing_settings")
}

model BillingCustomer {
  profileId          String   @id @db.Uuid
  provider           String
  providerCustomerId String   @unique
  createdAt          DateTime @default(now())

  profile Profile @relation("BillingCustomerProfile", fields: [profileId], references: [id], onDelete: Restrict)

  @@map("billing_customers")
}

/// Written only by the verified webhook handler. (The legacy `Subscription`
/// model above is the earlier business model's tiered Agent plan.)
model BillingSubscription {
  id                     String               @id @db.Uuid
  profileId              String               @db.Uuid
  audience               SubscriptionAudience
  interval               BillingInterval
  provider               String
  providerSubscriptionId String               @unique
  providerPriceId        String
  status                 SubscriptionStatus
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean              @default(false)
  pastDueSince           DateTime?
  lastEventAt            DateTime
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  profile Profile @relation("SubscriptionProfile", fields: [profileId], references: [id], onDelete: Restrict)

  @@index([profileId, audience])
  @@index([status])
  @@map("subscriptions")
}

/// Webhook idempotency: recorded in the same transaction that applies it.
model BillingWebhookEvent {
  eventId        String   @id
  provider       String
  type           String
  eventCreatedAt DateTime
  receivedAt     DateTime @default(now())

  @@map("billing_webhook_events")
}

enum ChatContextType {
  PRIVATE_LISTING
  PROJECT
  RETAIL_LISTING
}

enum ChatPairType {
  LANDLORD_AGENT
  AGENT_INVESTOR
  LEAD_CO_INVESTOR
  BUYER_AGENT
}

/// Stored state. "Read-only" is computed: an AUTHORIZED thread is read-only
/// while a participant who must pay has a lapsed subscription (ADR-043).
enum ChatThreadStatus {
  PENDING
  AUTHORIZED
  CLOSED
}

enum ChatAuthorizationAction {
  REQUESTED
  APPROVED
  REJECTED
  REVOKED
  CLOSED
  REOPENED
}

enum ChatReportStatus {
  OPEN
  RESOLVED
}

/// One-to-one, context-bound chat (Phase 3, ADR-043). The pair matrix, two
/// distinct people and each participant's relationship to the context are
/// enforced in the database.
model ChatThread {
  id                    String           @id @db.Uuid
  contextType           ChatContextType
  contextId             String
  pairType              ChatPairType
  participantA          String           @db.Uuid
  participantB          String           @db.Uuid
  status                ChatThreadStatus @default(PENDING)
  requiresAuthorization Boolean          @default(true)
  authorizedAt          DateTime?
  closedAt              DateTime?
  closedReason          String?
  lastMessageAt         DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  a              Profile             @relation("ChatThreadParticipantA", fields: [participantA], references: [id], onDelete: Restrict)
  b              Profile             @relation("ChatThreadParticipantB", fields: [participantB], references: [id], onDelete: Restrict)
  authorizations ChatAuthorization[]
  messages       ChatThreadMessage[]
  reports        ChatReport[]

  @@unique([contextType, contextId, participantA, participantB], map: "chat_threads_context_pair_key")
  @@index([participantA])
  @@index([participantB])
  @@index([status, createdAt])
  @@map("chat_threads")
}

/// Append-only history of who requested, approved, rejected, revoked or closed.
model ChatAuthorization {
  id        String                  @id @db.Uuid
  threadId  String                  @db.Uuid
  action    ChatAuthorizationAction
  actorId   String?                 @db.Uuid
  reason    String?
  createdAt DateTime                @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  actor  Profile?   @relation("ChatAuthorizationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@map("chat_authorizations")
}

/// Never edited or deleted; only the recipient's read time is set once.
model ChatThreadMessage {
  id              String    @id @db.Uuid
  threadId        String    @db.Uuid
  senderId        String    @db.Uuid
  body            String
  /// Client idempotency key: a retried send is the same message.
  clientMessageId String
  createdAt       DateTime  @default(now())
  readAt          DateTime?

  thread      ChatThread              @relation(fields: [threadId], references: [id], onDelete: Restrict)
  sender      Profile                 @relation("ChatThreadMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  attachments ChatMessageAttachment[]

  @@unique([threadId, senderId, clientMessageId], map: "chat_thread_messages_idempotency_key")
  @@index([threadId, createdAt])
  @@map("chat_thread_messages")
}

model ChatMessageAttachment {
  messageId String   @db.Uuid
  fileId    String   @db.Uuid
  createdAt DateTime @default(now())

  message ChatThreadMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  file    UploadedFile      @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([messageId, fileId])
  @@index([fileId])
  @@map("chat_message_attachments")
}

model ChatReport {
  id         String           @id @db.Uuid
  threadId   String           @db.Uuid
  reporterId String           @db.Uuid
  reason     String
  status     ChatReportStatus @default(OPEN)
  resolution String?
  resolvedBy String?          @db.Uuid
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  reporter Profile    @relation("ChatReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolver Profile?   @relation("ChatReportResolver", fields: [resolvedBy], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("chat_reports")
}

// ── Phase 4 Tasks 1-2: investor projects and Lead assignment (ADR-044) ──

enum InvestorProjectStatus {
  PUBLISHED
  OPEN_FOR_INVESTMENT
  FUNDED
  IN_WORKS
  COMPLETED
  LISTED_FOR_SALE
  SOLD
  CLOSED
}

enum InvestorProjectMode {
  REFURBISHMENT
  DEVELOPMENT_JV
}

enum LeadNominationStatus {
  NOMINATED
  ACCEPTED
  APPROVED
  DECLINED
  REJECTED
  WITHDRAWN
}

/// A project published to investors from an ACTIVE mandate (TRD AG-5). The
/// investor page is built from the mandate's disclosure (ADR-040), never from
/// the raw listing. Money in pence. Guarded by triggers (transitions, terms
/// fixed once open, Lead set once from an approved nomination).
model InvestorProject {
  id                 String                @id @db.Uuid
  mandateId          String                @unique @db.Uuid
  listingId          String                @db.Uuid
  agentId            String                @db.Uuid
  mode               InvestorProjectMode   @default(REFURBISHMENT)
  status             InvestorProjectStatus @default(PUBLISHED)
  title              String
  summary            String
  capitalRequiredGBP BigInt
  minimumPledgeGBP   BigInt
  fundingDeadline    DateTime
  purchaseGBP        BigInt
  marketValueGBP     BigInt
  /// Shown only when FINANCIAL_PROMOTIONS_REVIEWED is true.
  expectedProfitGBP  BigInt?
  expectedMonths     Int?
  leadInvestorId     String?               @db.Uuid
  leadConfirmedAt    DateTime?
  publishedBy        String                @db.Uuid
  publishedAt        DateTime              @default(now())
  statusChangedAt    DateTime              @default(now())
  closedReason       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  mandate     Mandate                 @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  listing     LandlordListing         @relation(fields: [listingId], references: [id], onDelete: Restrict)
  agent       Profile                 @relation("InvestorProjectAgent", fields: [agentId], references: [id], onDelete: Restrict)
  lead        Profile?                @relation("InvestorProjectLead", fields: [leadInvestorId], references: [id], onDelete: Restrict)
  publisher   Profile                 @relation("InvestorProjectPublisher", fields: [publishedBy], references: [id], onDelete: Restrict)
  interests   ProjectInterest[]
  nominations ProjectLeadNomination[]
  pledges     ProjectPledge[]
  favourites  ProjectFavourite[]
  questions   ProjectQuestion[]
  solicitors  ProjectSolicitor[]
  agreements  ProjectAgreement[]
  fundStatuses ProjectFundStatus[]
  costs       ProjectCost[]
  milestones  ProjectMilestone[]
  updates     ProjectUpdate[]
  changes     ProjectChange[]
  sale        ProjectSale?
  ledger      DistributionLedgerEntry[]
  corrections LedgerCorrection[]
  decisions   ProjectDecision[]
  retailListing ProjectRetailListing?

  @@index([status, publishedAt])
  @@index([agentId])
  @@index([leadInvestorId])
  @@map("investor_projects")
}

model ProjectInterest {
  id          String    @id @db.Uuid
  projectId   String    @db.Uuid
  investorId  String    @db.Uuid
  createdAt   DateTime  @default(now())
  withdrawnAt DateTime?

  project  InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  investor Profile         @relation("ProjectInterestInvestor", fields: [investorId], references: [id], onDelete: Restrict)

  @@unique([projectId, investorId])
  @@index([investorId])
  @@map("project_interests")
}

/// OD-13: Agent nominates → nominee accepts → Admin approves. One live
/// nomination and one APPROVED per project (partial unique indexes).
model ProjectLeadNomination {
  id          String               @id @db.Uuid
  projectId   String               @db.Uuid
  investorId  String               @db.Uuid
  nominatedBy String               @db.Uuid
  status      LeadNominationStatus @default(NOMINATED)
  nominatedAt DateTime             @default(now())
  respondedAt DateTime?
  decidedAt   DateTime?
  decidedBy   String?              @db.Uuid
  reason      String?
  updatedAt   DateTime             @updatedAt

  project   InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  investor  Profile         @relation("LeadNominationInvestor", fields: [investorId], references: [id], onDelete: Restrict)
  nominator Profile         @relation("LeadNominationNominator", fields: [nominatedBy], references: [id], onDelete: Restrict)
  decider   Profile?        @relation("LeadNominationDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([investorId])
  @@index([status, nominatedAt])
  @@map("project_lead_nominations")
}

// ── Phase 4 Task 4: pledges (ADR-045) ──

enum PledgeState {
  PLEDGED
  BINDING
  CANCELLED
  RELEASED
}

/// An expression of interest until the agreement is signed (BINDING). No money
/// moves through the app. A trigger locks the project row on every write so
/// live pledges never exceed the capital required; another keeps the project
/// FUNDED exactly when they reach it.
model ProjectPledge {
  id             String      @id @db.Uuid
  projectId      String      @db.Uuid
  investorId     String      @db.Uuid
  amountGBP      BigInt
  status         PledgeState @default(PLEDGED)
  idempotencyKey String
  createdAt      DateTime    @default(now())
  bindingAt      DateTime?
  endedAt        DateTime?
  endedReason    String?
  updatedAt      DateTime    @updatedAt

  project  InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  investor Profile         @relation("ProjectPledgeInvestor", fields: [investorId], references: [id], onDelete: Restrict)
  agreementParties AgreementParty[]
  fundStatuses     ProjectFundStatus[]

  @@unique([investorId, idempotencyKey])
  @@index([projectId, status])
  @@index([investorId])
  @@map("project_pledges")
}

// ── Phase 4 Task 3: Investor Portal (ADR-046) ──

model ProjectFavourite {
  investorId String   @db.Uuid
  projectId  String   @db.Uuid
  createdAt  DateTime @default(now())

  investor Profile         @relation("ProjectFavouriteInvestor", fields: [investorId], references: [id], onDelete: Cascade)
  project  InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@id([investorId, projectId])
  @@index([projectId])
  @@map("project_favourites")
}

enum ProjectQuestionStatus {
  OPEN
  ANSWERED
  HIDDEN
}

/// Project Q&A: asked by the project's investors, answered once by its Agent,
/// visible to its investors (askers anonymous to each other); Admin may hide.
model ProjectQuestion {
  id           String                @id @db.Uuid
  projectId    String                @db.Uuid
  askerId      String                @db.Uuid
  body         String
  status       ProjectQuestionStatus @default(OPEN)
  answer       String?
  answeredBy   String?               @db.Uuid
  answeredAt   DateTime?
  hiddenBy     String?               @db.Uuid
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  project   InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  asker     Profile         @relation("ProjectQuestionAsker", fields: [askerId], references: [id], onDelete: Restrict)
  answerer  Profile?        @relation("ProjectQuestionAnswerer", fields: [answeredBy], references: [id], onDelete: Restrict)
  moderator Profile?        @relation("ProjectQuestionModerator", fields: [hiddenBy], references: [id], onDelete: Restrict)

  @@index([projectId, status, createdAt])
  @@index([askerId])
  @@map("project_questions")
}

// ── Phase 4 Task 5: Solicitor accounts (ADR-047) ──

enum ProjectSolicitorStatus {
  INVITED
  ACTIVE
  CLOSED
  REVOKED
}

/// One Solicitor account per project (Admin-created, expiring single-use
/// invitation, mandatory MFA). The profile is bound to this one project.
model ProjectSolicitor {
  id          String                 @id @db.Uuid
  projectId   String                 @db.Uuid
  profileId   String?                @unique @db.Uuid
  email       String
  name        String
  firm        String
  status      ProjectSolicitorStatus @default(INVITED)
  tokenHash   String                 @unique
  expiresAt   DateTime
  invitedBy   String                 @db.Uuid
  invitedAt   DateTime               @default(now())
  acceptedAt  DateTime?
  endedAt     DateTime?
  endedBy     String?                @db.Uuid
  endedReason String?
  updatedAt   DateTime               @updatedAt

  project InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  profile Profile?        @relation("ProjectSolicitorProfile", fields: [profileId], references: [id], onDelete: Restrict)
  inviter Profile         @relation("ProjectSolicitorInviter", fields: [invitedBy], references: [id], onDelete: Restrict)
  ender   Profile?        @relation("ProjectSolicitorEnder", fields: [endedBy], references: [id], onDelete: Restrict)

  @@index([email])
  @@map("project_solicitors")
}

// ── Phase 4 Task 6: agreements and e-signature (ADR-048) ──

enum AgreementStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  EXPIRED
  VOIDED
}

enum AgreementPartyRole {
  INVESTOR
  LANDLORD
  AGENT
}

enum AgreementSignerStatus {
  PENDING
  SIGNED
  DECLINED
}

/// A versioned project agreement prepared by the project's Solicitor. Signed
/// through the e-signature provider; the signed PDF is stored privately with
/// its SHA-256. Loss allocation and cancellation payment are agreement terms
/// stored as written (OD-06), never computed.
model ProjectAgreement {
  id                     String          @id @db.Uuid
  projectId              String          @db.Uuid
  version                Int
  title                  String
  draftFileId            String          @db.Uuid
  status                 AgreementStatus @default(DRAFT)
  provider               String?
  envelopeId             String?
  testMode               Boolean         @default(true)
  sentAt                 DateTime?
  completedAt            DateTime?
  signedFileId           String?         @db.Uuid
  signedSha256           String?
  lossAllocation         String
  cancellationPaymentGBP BigInt?
  cancellationTerms      String?
  otherTerms             String?
  createdBy              String          @db.Uuid
  endedReason            String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  project    InvestorProject  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  draftFile  UploadedFile     @relation("ProjectAgreementDraft", fields: [draftFileId], references: [id], onDelete: Restrict)
  signedFile UploadedFile?    @relation("ProjectAgreementSigned", fields: [signedFileId], references: [id], onDelete: Restrict)
  creator    Profile          @relation("ProjectAgreementCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  parties    AgreementParty[]
  ledger     DistributionLedgerEntry[]

  @@unique([projectId, version])
  @@map("project_agreements")
}

/// A signatory. sharePpm is the party's share of the project in parts per
/// million (0 = signs without an economic interest).
model AgreementParty {
  id               String                @id @db.Uuid
  agreementId      String                @db.Uuid
  profileId        String                @db.Uuid
  partyRole        AgreementPartyRole
  sharePpm         BigInt
  pledgeId         String?               @db.Uuid
  signerStatus     AgreementSignerStatus @default(PENDING)
  providerSignerId String?
  signedAt         DateTime?
  declinedAt       DateTime?
  createdAt        DateTime              @default(now())

  agreement ProjectAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  profile   Profile          @relation("AgreementPartyProfile", fields: [profileId], references: [id], onDelete: Restrict)
  pledge    ProjectPledge?   @relation(fields: [pledgeId], references: [id], onDelete: Restrict)

  @@unique([agreementId, profileId])
  @@index([profileId])
  @@map("agreement_parties")
}

/// Verified e-signature events (replay protection); append-only.
model ESignWebhookEvent {
  id         String
  provider   String
  envelopeId String
  type       String
  occurredAt DateTime
  receivedAt DateTime @default(now())

  @@id([provider, id])
  @@map("esign_webhook_events")
}

// ── Phase 4 Task 7: funds status, costs, milestones, updates, changes (ADR-049) ──

enum FundStatus {
  AWAITING
  RECEIVED
  PART_RECEIVED
  RETURNED
}

enum ProjectCostCategory {
  MATERIALS
  CONTRACTOR
  AGENT_FEES
  LEGAL_FEES
  TAXES
  OTHER
}

enum ProjectMilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
}

enum ProjectUpdateAudience {
  INVESTORS
  INVESTORS_AND_LANDLORD
}

enum ProjectChangeKind {
  BUDGET
  TIMELINE
  SCOPE
}

enum ProjectChangeStatus {
  PROPOSED
  APPROVED
  REJECTED
}

/// What the Solicitor's client account received for a pledge (status only;
/// nothing moves through PropLink). Append-only history; latest wins.
model ProjectFundStatus {
  id          String     @id @db.Uuid
  projectId   String     @db.Uuid
  pledgeId    String     @db.Uuid
  status      FundStatus
  receivedGBP BigInt?
  note        String?
  recordedBy  String     @db.Uuid
  recordedAt  DateTime   @default(now())

  project  InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  pledge   ProjectPledge   @relation(fields: [pledgeId], references: [id], onDelete: Restrict)
  recorder Profile         @relation("ProjectFundStatusRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([pledgeId, recordedAt])
  @@index([projectId])
  @@map("project_fund_statuses")
}

/// An itemised cost. Never edited: voided with a reason and recorded again.
model ProjectCost {
  id          String              @id @db.Uuid
  projectId   String              @db.Uuid
  category    ProjectCostCategory
  description String
  amountGBP   BigInt
  incurredOn  DateTime            @db.Date
  recordedBy  String              @db.Uuid
  createdAt   DateTime            @default(now())
  voidedAt    DateTime?
  voidedBy    String?             @db.Uuid
  voidReason  String?

  project  InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recorder Profile         @relation("ProjectCostRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  voider   Profile?        @relation("ProjectCostVoider", fields: [voidedBy], references: [id], onDelete: Restrict)

  @@index([projectId, incurredOn])
  @@map("project_costs")
}

model ProjectMilestone {
  id          String                 @id @db.Uuid
  projectId   String                 @db.Uuid
  title       String
  status      ProjectMilestoneStatus @default(PLANNED)
  dueOn       DateTime?              @db.Date
  completedAt DateTime?
  createdBy   String                 @db.Uuid
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator Profile         @relation("ProjectMilestoneCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("project_milestones")
}

/// The project's in-app feed (append-only); some updates also reach the Landlord.
model ProjectUpdate {
  id        String                @id @db.Uuid
  projectId String                @db.Uuid
  authorId  String                @db.Uuid
  audience  ProjectUpdateAudience @default(INVESTORS)
  title     String
  body      String
  createdAt DateTime              @default(now())

  project InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author  Profile         @relation("ProjectUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("project_updates")
}

/// A budget, timeline or scope change: recorded by the Solicitor, decided by
/// the Lead Investor (executive authority, Q20-Q23).
model ProjectChange {
  id              String              @id @db.Uuid
  projectId       String              @db.Uuid
  kind            ProjectChangeKind
  summary         String
  budgetDeltaGBP  BigInt?
  newCompletionOn DateTime?           @db.Date
  status          ProjectChangeStatus @default(PROPOSED)
  recordedBy      String              @db.Uuid
  recordedAt      DateTime            @default(now())
  decidedBy       String?             @db.Uuid
  decidedAt       DateTime?
  decisionNote    String?

  project  InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recorder Profile         @relation("ProjectChangeRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  decider  Profile?        @relation("ProjectChangeDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([projectId, recordedAt])
  @@map("project_changes")
}

// ── Phase 4 Task 8: sale record and distribution ledger (ADR-050) ──

enum ProjectSaleStatus {
  RECORDED
  CONFIRMED
}

enum LedgerEntryType {
  CAPITAL_RETURN
  PROFIT_SHARE
  LOSS_SHARE
  ADJUSTMENT
}

enum LedgerPartyRole {
  INVESTOR
  LANDLORD
  AGENT
}

enum LedgerCorrectionStatus {
  PROPOSED
  APPROVED
  REJECTED
}

/// The sale (TRD PD-1): recorded by the Agent, confirmed by the Solicitor; the
/// input to settlement. Net profit = sale − purchase − itemised costs (CHECK).
model ProjectSale {
  id             String            @id @db.Uuid
  projectId      String            @unique @db.Uuid
  status         ProjectSaleStatus @default(RECORDED)
  salePriceGBP   BigInt
  purchaseGBP    BigInt
  totalCostsGBP  BigInt
  netProfitGBP   BigInt
  roiBasisPoints BigInt
  soldOn         DateTime          @db.Date
  recordedBy     String            @db.Uuid
  recordedAt     DateTime          @default(now())
  confirmedBy    String?           @db.Uuid
  confirmedAt    DateTime?

  project   InvestorProject           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recorder  Profile                   @relation("ProjectSaleRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  confirmer Profile?                  @relation("ProjectSaleConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict)
  ledger    DistributionLedgerEntry[]

  @@map("project_sales")
}

/// Append-only distribution ledger (no UPDATE or DELETE for any role). It
/// records what the Solicitor pays outside PropLink under the signed agreement.
model DistributionLedgerEntry {
  id               String          @id @db.Uuid
  projectId        String          @db.Uuid
  partyId          String          @db.Uuid
  partyRole        LedgerPartyRole
  entryType        LedgerEntryType
  amountGBP        BigInt
  sharePpm         BigInt
  agreementId      String          @db.Uuid
  agreementVersion Int
  saleId           String          @db.Uuid
  correctionId     String?         @db.Uuid
  actorId          String          @db.Uuid
  createdAt        DateTime        @default(now())

  project     InvestorProject    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  party       Profile            @relation("LedgerEntryParty", fields: [partyId], references: [id], onDelete: Restrict)
  agreement   ProjectAgreement   @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  sale        ProjectSale        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  correction  LedgerCorrection?  @relation("LedgerCorrectionAdjustment", fields: [correctionId], references: [id], onDelete: Restrict)
  actor       Profile            @relation("LedgerEntryActor", fields: [actorId], references: [id], onDelete: Restrict)
  corrections LedgerCorrection[] @relation("LedgerCorrectionTarget")

  @@index([projectId, createdAt])
  @@index([partyId])
  @@map("distribution_ledger")
}

/// A correction: proposed by the project's Solicitor, approved by Admin, then
/// applied as an ADJUSTMENT entry; the original entry is kept.
model LedgerCorrection {
  id           String                 @id @db.Uuid
  projectId    String                 @db.Uuid
  entryId      String                 @db.Uuid
  amountGBP    BigInt
  reason       String
  status       LedgerCorrectionStatus @default(PROPOSED)
  proposedBy   String                 @db.Uuid
  proposedAt   DateTime               @default(now())
  decidedBy    String?                @db.Uuid
  decidedAt    DateTime?
  decisionNote String?

  project     InvestorProject           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  entry       DistributionLedgerEntry   @relation("LedgerCorrectionTarget", fields: [entryId], references: [id], onDelete: Restrict)
  proposer    Profile                   @relation("LedgerCorrectionProposer", fields: [proposedBy], references: [id], onDelete: Restrict)
  decider     Profile?                  @relation("LedgerCorrectionDecider", fields: [decidedBy], references: [id], onDelete: Restrict)
  adjustments DistributionLedgerEntry[] @relation("LedgerCorrectionAdjustment")

  @@index([projectId, proposedAt])
  @@map("ledger_corrections")
}

// ── Phase 4 Task 9: project decisions (ADR-051) ──

enum ProjectDecisionKind {
  EXTEND_DEADLINE
  CLOSE_PROJECT
  RELEASE_PLEDGES
}

/// Q44 edge cases: the project owner's recorded choice (append-only). Money
/// (refunds, cancellation payments) is the Solicitor's, outside PropLink.
model ProjectDecision {
  id               String              @id @db.Uuid
  projectId        String              @db.Uuid
  kind             ProjectDecisionKind
  reason           String
  newDeadline      DateTime?
  previousDeadline DateTime?
  pledgesReleased  Int                 @default(0)
  decidedBy        String              @db.Uuid
  decidedAt        DateTime            @default(now())

  project InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  decider Profile         @relation("ProjectDecisionMaker", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([projectId, decidedAt])
  @@map("project_decisions")
}

// ── Phase 5 Tasks 1 and 1a: re-listing completed projects (ADR-052) ──

/// A completed investor project's retail listing (an ordinary Property, Admin
/// reviewed), linked so the listing keeps the project's history.
model ProjectRetailListing {
  projectId  String   @id @db.Uuid
  propertyId String   @unique
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now())

  project  InvestorProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  property Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  creator  Profile         @relation("ProjectRetailListingCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("project_retail_listings")
}

// ── Phase 5 Task 2: offer and viewing history (ADR-053) ──

model OfferEvent {
  id          String   @id @db.Uuid
  offerId     String
  fromStatus  String?
  toStatus    String
  amountGBP   Int?
  actorUserId String
  note        String?
  createdAt   DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([offerId, createdAt])
  @@map("offer_events")
}

model ViewingEvent {
  id          String    @id @db.Uuid
  viewingId   String
  fromStatus  String?
  toStatus    String
  slotStart   DateTime?
  actorUserId String
  note        String?
  createdAt   DateTime  @default(now())

  viewing Viewing @relation(fields: [viewingId], references: [id], onDelete: Restrict)

  @@index([viewingId, createdAt])
  @@map("viewing_events")
}

// ── Phase 5 Task 4: reviews and ratings (ADR-054) ──

enum ReviewContext {
  MANDATE
  PROJECT
  PURCHASE
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

/// 1-5 stars and text from a qualifying, completed interaction only (TRD RV,
/// criterion 7, OD-17); a trigger checks the pair. Admin publishes first; the
/// reviewed party may reply once. Never deleted.
model Review {
  id             String        @id @db.Uuid
  reviewerId     String        @db.Uuid
  subjectId      String        @db.Uuid
  contextType    ReviewContext
  contextId      String
  rating         Int
  body           String
  status         ReviewStatus  @default(PENDING)
  moderatedBy    String?       @db.Uuid
  moderatedAt    DateTime?
  moderationNote String?
  reply          String?
  repliedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())

  reviewer  Profile        @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  subject   Profile        @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  moderator Profile?       @relation("ReviewModerator", fields: [moderatedBy], references: [id], onDelete: Restrict)
  reports   ReviewReport[]

  @@unique([reviewerId, subjectId, contextType, contextId], map: "reviews_one_per_interaction")
  @@index([subjectId, status], map: "reviews_subject_status")
  @@index([status, createdAt], map: "reviews_status_created")
  @@index([reviewerId, createdAt], map: "reviews_reviewer_created")
  @@map("reviews")
}

model ReviewReport {
  id         String    @id @db.Uuid
  reviewId   String    @db.Uuid
  reporterId String    @db.Uuid
  reason     String
  resolvedAt DateTime?
  resolvedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  reporter Profile  @relation("ReviewReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolver Profile? @relation("ReviewReportResolver", fields: [resolvedBy], references: [id], onDelete: Restrict)

  @@unique([reviewId, reporterId], map: "review_reports_one_per_reporter")
  @@index([resolvedAt, createdAt], map: "review_reports_open")
  @@map("review_reports")
}

// ── Phase 5 Task 5: track record (ADR-055) ──

/// Single row. Historical ROI shows only when this is on AND
/// FINANCIAL_PROMOTIONS_REVIEWED is true (OD-07).
model TrackRecordSettings {
  id                Int      @id @default(1)
  showHistoricalRoi Boolean  @default(false)
  updatedAt         DateTime @default(now())
  updatedBy         String?  @db.Uuid

  editor Profile? @relation("TrackRecordSettingsEditor", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("track_record_settings")
}

// ── Phase 5 Task 3: saved-search alerts (ADR-056) ──

enum SavedSearchAlertStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

/// The alert queue: at most one per saved search per day; sent with per-user
/// limits; every email has an unsubscribe link.
model SavedSearchAlert {
  id            String                 @id @db.Uuid
  savedSearchId String
  userId        String
  windowDay     DateTime               @db.Date
  listingIds    String[]
  status        SavedSearchAlertStatus @default(QUEUED)
  createdAt     DateTime               @default(now())
  sentAt        DateTime?

  savedSearch SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId, windowDay], map: "saved_search_alerts_one_per_day")
  @@index([status, createdAt], map: "saved_search_alerts_status")
  @@index([userId, windowDay], map: "saved_search_alerts_user_day")
  @@map("saved_search_alerts")
}

// ── Phase 6 Task 2: Admin permissions with maker-checker (ADR-058) ──

enum AdminPermission {
  SUPER_ADMIN
  VERIFICATION
  LISTING_MODERATION
  CHAT_AUTHORIZATION
  REVIEW_MODERATION
  SUSPENSION
  FINANCIAL_ADJUSTMENTS
  SOLICITOR_MANAGEMENT
  ADVERTISER_MANAGEMENT
  SUBSCRIPTION_PRICING
  SYSTEM_INTEGRATIONS
  PROJECT_OVERSIGHT
  CASE_MANAGEMENT
}

enum AdminGrantAction {
  GRANT
  REVOKE
}

enum AdminGrantRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A super-admin asks; a different super-admin decides (trigger-enforced).
model AdminGrantRequest {
  id          String                  @id @db.Uuid
  targetId    String                  @db.Uuid
  permission  AdminPermission
  action      AdminGrantAction
  reason      String
  status      AdminGrantRequestStatus @default(PENDING)
  requestedBy String                  @db.Uuid
  decidedBy   String?                 @db.Uuid
  decidedAt   DateTime?
  createdAt   DateTime                @default(now())

  target    Profile  @relation("AdminGrantTarget", fields: [targetId], references: [id], onDelete: Restrict)
  requester Profile  @relation("AdminGrantRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  decider   Profile? @relation("AdminGrantDecider", fields: [decidedBy], references: [id], onDelete: Restrict)
  grants    AdminPermissionGrant[] @relation("AdminGrantFromRequest")
  revokes   AdminPermissionGrant[] @relation("AdminGrantRevokedBy")

  @@index([status, createdAt], map: "admin_grant_requests_status")
  @@map("admin_grant_requests")
}

/// Active while revokedAt is null. Created and revoked only via approved requests.
model AdminPermissionGrant {
  id              String          @id @db.Uuid
  profileId       String          @db.Uuid
  permission      AdminPermission
  requestId       String?         @db.Uuid
  grantedAt       DateTime        @default(now())
  revokedAt       DateTime?
  revokeRequestId String?         @db.Uuid

  holder        Profile            @relation("AdminGrantHolder", fields: [profileId], references: [id], onDelete: Restrict)
  request       AdminGrantRequest? @relation("AdminGrantFromRequest", fields: [requestId], references: [id], onDelete: Restrict)
  revokeRequest AdminGrantRequest? @relation("AdminGrantRevokedBy", fields: [revokeRequestId], references: [id], onDelete: Restrict)

  @@map("admin_permission_grants")
}

// ── Phase 6 Task 3: cases, disputes and data requests (ADR-059) ──

enum CaseSubjectType {
  CHAT
  REVIEW
  LISTING
  USER
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
}

enum DataExportStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// One open case per subject; further reports join it. Never deleted.
model Case {
  id          String          @id @db.Uuid
  subjectType CaseSubjectType
  subjectId   String
  title       String
  status      CaseStatus      @default(OPEN)
  priority    CasePriority    @default(NORMAL)
  assigneeId  String?         @db.Uuid
  openedBy    String?         @db.Uuid
  slaDueAt    DateTime
  resolution  String?
  resolvedBy  String?         @db.Uuid
  resolvedAt  DateTime?
  reportCount Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now())

  assignee    Profile?            @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  opener      Profile?            @relation("CaseOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  resolver    Profile?            @relation("CaseResolver", fields: [resolvedBy], references: [id], onDelete: Restrict)
  notes       CaseNote[]
  evidence    CaseEvidence[]
  dataExports DataExportRequest[]

  @@index([status, slaDueAt], map: "cases_status_sla")
  @@index([assigneeId, status], map: "cases_assignee")
  @@map("cases")
}

/// Append-only. kind: NOTE (Admin), REPORT (a member's report), EVENT (history).
model CaseNote {
  id        String   @id @db.Uuid
  caseId    String   @db.Uuid
  authorId  String?  @db.Uuid
  kind      String   @default("NOTE")
  body      String
  createdAt DateTime @default(now())

  case   Case     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  author Profile? @relation("CaseNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt], map: "case_notes_case")
  @@map("case_notes")
}

/// Append-only links (same-site paths or https only).
model CaseEvidence {
  id        String   @id @db.Uuid
  caseId    String   @db.Uuid
  addedBy   String   @db.Uuid
  label     String
  url       String
  createdAt DateTime @default(now())

  case  Case    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  adder Profile @relation("CaseEvidenceAdder", fields: [addedBy], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt], map: "case_evidence_case")
  @@map("case_evidence")
}

/// GDPR data export: one case manager records it, a different one approves.
model DataExportRequest {
  id          String           @id @db.Uuid
  subjectId   String           @db.Uuid
  caseId      String?          @db.Uuid
  reason      String
  status      DataExportStatus @default(REQUESTED)
  requestedBy String           @db.Uuid
  decidedBy   String?          @db.Uuid
  decidedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  subject   Profile  @relation("DataExportSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  requester Profile  @relation("DataExportRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  decider   Profile? @relation("DataExportDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([status, createdAt], map: "data_export_requests_status")
  @@map("data_export_requests")
}
