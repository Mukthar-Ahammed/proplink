// PropLink UK — full core schema (Sprint 1, Task 1.2).
// Geospatial (PostGIS) and full-text (tsvector) columns are Unsupported types;
// their indexes and triggers live in raw SQL migrations.
// Money convention: ALL *GBP fields are integer PENCE.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Authoritative application role, server-written only (never from the client).
/// LANDLORD: public sign-up (Phase 1 Task 2). SOLICITOR: Admin-created, one per
/// project (Phase 4). ADVERTISER: Admin-approved advertiser account (Phase 6).
/// ADMIN, AGENT, SOLICITOR and ADVERTISER can never be chosen at sign-up.
enum Role {
  AGENT
  INVESTOR
  BUYER
  ADMIN
  LANDLORD
  SOLICITOR
  ADVERTISER
}

/// What an INVESTOR may do on projects. One investor may hold both; the role on
/// a specific project (Lead or Co-Investor) is decided per project in Phase 4.
enum InvestorCapability {
  LEAD_INVESTOR
  CO_INVESTOR
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

/// KYC document kind — drives file-type allowlists and storage path prefix.
enum KycDocumentKind {
  PASSPORT
  DRIVERS_LICENCE
  NATIONAL_ID
  PROOF_OF_ADDRESS
  COMPANY_REGISTRATION
  OTHER
}

/// KYC submission lifecycle status (not the same as KycStatus on the profile).
/// DRAFT → SUBMITTED → (Admin reviews in Phase 5) APPROVED or REJECTED.
enum KycSubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvestorType {
  FLIPPER
  SYNDICATE
  BOTH
}

enum ListingSource {
  AGENT
  FLIPPER_RESALE
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  LIVE
  UNDER_OFFER
  SOLD
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  HMO
  LAND
}

enum EpcRating {
  A
  B
  C
  D
  E
  F
  G
}

enum DistressTag {
  SUBSIDENCE
  DAMP
  RENOVATION_NEEDED
  PROBATE
  ASBESTOS
  ROOF_REQUIRED
  WATER_DAMAGE
  FIRE_DAMAGE
}

enum SyndicateStatus {
  OPEN
  FUNDED
  IN_REFURB
  LISTED
  COMPLETED
}

enum PledgeStatus {
  PLEDGED
  CONFIRMED
  WITHDRAWN
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
}

enum LedgerType {
  EXPENSE
  CAPITAL_INJECTION
}

enum EnquiryStatus {
  NEW
  RESPONDED
  CLOSED
}

enum SubscriptionTier {
  STARTER
  PRO
  ELITE
}

enum OfferStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DealStage {
  OFFER_ACCEPTED
  SOLICITOR_REFERRED
  CONVEYANCING
  EXCHANGED
  COMPLETED
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  DONE
}

enum PartnerCategory {
  INSURANCE
  CONVEYANCING
  STAGING
  TRADES
  SURVEYOR
  SOLICITOR
}

enum AdModel {
  CPM
  CPC
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?
  name           String
  role           Role
  emailVerified  DateTime?
  kycStatus      KycStatus @default(NOT_STARTED)
  complianceCode String?
  avatarUrl      String?
  gdprConsentAt  DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  agentProfiles     AgentProfile[]
  pledges           SyndicatePledge[]
  enquiries         Enquiry[]
  savedProperties   SavedProperty[]
  savedSearches     SavedSearch[]
  appraisals        Appraisal[]
  subscription      Subscription?
  offers            Offer[]
  viewings           Viewing[]
  sentMessages      ChatMessage[]     @relation("SentMessages")
  receivedMessages  ChatMessage[]     @relation("ReceivedMessages")
  kycRecords        KycRecord[]
  kycSubmissions    KycSubmission[]
  auditLogs         AuditLog[]
  ledgerEntries     LedgerEntry[]
  verificationTokens VerificationToken[]
  authProfile       Profile?

  flipperOpportunities FlipperOpportunity[]
  flipperOffers        FlipperOffer[]
  flipperAcquisitions  FlipperAcquisition[]
  flipperProjects      FlipperProject[]
  flipperResales       FlipperResale[]
}

/// Supabase Auth extension row. The UUID primary key is also a database-level
/// foreign key to auth.users(id), created in the raw SQL migration.
model Profile {
  id             String    @id @db.Uuid
  legacyUserId   String?   @unique
  role           Role      @default(BUYER)
  investorType   InvestorType?
  name           String?
  kycStatus      KycStatus @default(NOT_STARTED)
  complianceCode String?
  avatarUrl      String?
  gdprConsentAt  DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  legacyUser User? @relation(fields: [legacyUserId], references: [id], onDelete: SetNull)
  investorCapabilities InvestorCapabilityGrant[]

  @@map("profiles")
}

/// Server-granted investor capabilities (Phase 1 Task 1). Rows are allowed only
/// for INVESTOR profiles (enforced by a trigger). Written by the server only;
/// all Data API privileges are revoked.
model InvestorCapabilityGrant {
  profileId  String             @db.Uuid
  capability InvestorCapability
  grantedAt  DateTime           @default(now())
  /// Admin profile that granted it; null for the migration backfill.
  grantedBy  String?            @db.Uuid

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, capability])
  @@map("investor_capabilities")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  purpose   String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AgentProfile {
  id                String  @id @default(cuid())
  userId            String
  agencyName        String
  bio               String?
  rating            Float   @default(0)
  verifiedDealCount Int     @default(0)
  complianceCode    String  @unique
  active            Boolean @default(true)

  user        User        @relation(fields: [userId], references: [id])
  properties  Property[]
  caseStudies CaseStudy[]
  appraisals  Appraisal[]

  @@index([userId])
}

model Property {
  id             String         @id @default(cuid())
  agentProfileId String?
  listingSource  ListingSource  @default(AGENT)
  title          String
  description    String
  status         PropertyStatus @default(DRAFT)
  addressLine1   String
  city           String
  region         String
  postcode       String
  /// PostGIS point; set via raw SQL from lat/lng. GIST-indexed in migration.
  location       Unsupported("geography(Point,4326)")?
  propertyType   PropertyType
  bedrooms       Int            @default(0)
  askingPriceGBP Int // pence
  targetRoiPct   Float?
  epcRating      EpcRating?
  epcCertUrl     String?
  floorPlanUrl   String?
  /// Agent's confirmation (Task 2.2 wizard step 3) that the seller has been
  /// advised the asking price may be revised after survey findings, and that
  /// any change will be disclosed to buyers before offers are accepted.
  /// Required before submitForReview; null while still drafting.
  pricingSafeguardAckAt DateTime?
  /// Task 2.6 analytics: incremented once per browser session per visitor by
  /// `POST /api/listings/[id]/view`; the owning agent's and admins' own views
  /// are never counted. Saves are not denormalised here — they are counted
  /// live from `SavedProperty`, which has no equivalent double-count problem.
  viewCount      Int            @default(0)
  /// Maintained by trigger in migration; GIN-indexed.
  searchVector   Unsupported("tsvector")?
  createdAt      DateTime       @default(now())
  /// Set by `transitionStatus` whenever a listing moves to PENDING_REVIEW —
  /// distinct from `createdAt` because a resubmission after a Task 2.3
  /// rejection must show the *new* submission date in the moderation queue.
  submittedAt    DateTime?
  publishedAt    DateTime?
  /// Admin's reason (Task 2.3 moderation) for the most recent reject back to
  /// DRAFT; cleared on approval. Null until a listing has been rejected once.
  rejectionReason String?

  agentProfile      AgentProfile?         @relation(fields: [agentProfileId], references: [id])
  resaleFor         FlipperResale?        @relation("ResaleProperty")
  distressTags      PropertyDistressTag[]
  images            PropertyImage[]
  syndicateProjects SyndicateProject[]
  enquiries         Enquiry[]
  savedBy           SavedProperty[]
  successFees       SuccessFee[]
  offers            Offer[]
  deals             Deal[]
  viewings          Viewing[]
  chatMessages      ChatMessage[]
  flipperOpportunities FlipperOpportunity[]
  flipperOffers        FlipperOffer[]
  flipperAcquisitions  FlipperAcquisition[]
  flipperProjects      FlipperProject[]
  flipperResales       FlipperResale[]

  @@index([status])
  @@index([agentProfileId])
  @@index([postcode])
  @@index([city])
}

model PropertyDistressTag {
  propertyId String
  tag        DistressTag

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, tag])
}

model PropertyImage {
  id         String @id @default(cuid())
  propertyId String
  url        String
  sortOrder  Int    @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model SyndicateProject {
  id                      String          @id @default(cuid())
  propertyId              String
  name                    String
  capitalTargetGBP        Int // pence
  equityModelNotes        String?
  status                  SyndicateStatus @default(OPEN)
  capitalProtectionPolicy String?
  createdAt               DateTime        @default(now())

  property    Property          @relation(fields: [propertyId], references: [id])
  pledges     SyndicatePledge[]
  milestones  Milestone[]
  ledger      LedgerEntry[]
  successFees SuccessFee[]

  @@index([status])
  @@index([propertyId])
}

/// EOI mode: pledges record intent only — money NEVER moves (see docs/CONTEXT.md).
model SyndicatePledge {
  id             String       @id @default(cuid())
  projectId      String
  investorUserId String
  amountGBP      Int // pence
  status         PledgeStatus @default(PLEDGED)
  createdAt      DateTime     @default(now())

  project  SyndicateProject @relation(fields: [projectId], references: [id])
  investor User             @relation(fields: [investorUserId], references: [id])

  @@index([projectId])
  @@index([investorUserId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  notes       String?
  status      MilestoneStatus @default(PLANNED)
  completedAt DateTime?

  project SyndicateProject @relation(fields: [projectId], references: [id])
  photos  MilestonePhoto[]

  @@index([projectId])
}

model MilestonePhoto {
  id          String @id @default(cuid())
  milestoneId String
  url         String

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model LedgerEntry {
  id          String     @id @default(cuid())
  projectId   String
  type        LedgerType
  amountGBP   Int // pence
  description String
  createdBy   String
  createdAt   DateTime   @default(now())

  project SyndicateProject @relation(fields: [projectId], references: [id])
  author  User             @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([createdBy])
}

model Enquiry {
  id         String        @id @default(cuid())
  propertyId String
  fromUserId String
  message    String
  status     EnquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  from     User     @relation(fields: [fromUserId], references: [id])

  @@index([propertyId])
  @@index([fromUserId])
}

model SavedProperty {
  userId     String
  propertyId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
}

model SavedSearch {
  id            String  @id @default(cuid())
  userId        String
  name          String
  paramsJson    Json
  alertsEnabled Boolean @default(false)
  lastAlertAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CaseStudy {
  id             String  @id @default(cuid())
  agentProfileId String
  title          String
  capexGBP       Int // pence
  netMarginGBP   Int // pence
  description    String
  imageUrl       String?

  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id])

  @@index([agentProfileId])
}

model Appraisal {
  id             String   @id @default(cuid())
  agentProfileId String
  investorUserId String
  rating         Int // 1..5, checked in service layer
  review         String
  createdAt      DateTime @default(now())

  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id])
  investor     User         @relation(fields: [investorUserId], references: [id])

  @@unique([agentProfileId, investorUserId])
  @@index([investorUserId])
}

model Subscription {
  id               String           @id @default(cuid())
  agentUserId      String           @unique
  stripeCustomerId String?
  stripeSubId      String?
  tier             SubscriptionTier @default(STARTER)
  status           String           @default("inactive")
  listingLimit     Int              @default(3)

  agent User @relation(fields: [agentUserId], references: [id])
}

model SuccessFee {
  id         String   @id @default(cuid())
  propertyId String
  projectId  String?
  amountGBP  Int // pence
  vatGBP     Int // pence
  loggedAt   DateTime @default(now())

  property Property          @relation(fields: [propertyId], references: [id])
  project  SyndicateProject? @relation(fields: [projectId], references: [id])

  @@index([propertyId])
  @@index([projectId])
}

model Offer {
  id          String      @id @default(cuid())
  propertyId  String
  buyerUserId String
  amountGBP   Int // pence
  status      OfferStatus @default(SUBMITTED)
  createdAt   DateTime    @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  buyer    User     @relation(fields: [buyerUserId], references: [id])
  deals    Deal[]

  @@index([propertyId])
  @@index([buyerUserId])
}

model Deal {
  id         String    @id @default(cuid())
  propertyId String
  offerId    String
  stage      DealStage @default(OFFER_ACCEPTED)
  updatedAt  DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  offer    Offer    @relation(fields: [offerId], references: [id])

  @@index([propertyId])
  @@index([offerId])
}

model Viewing {
  id          String        @id @default(cuid())
  propertyId  String
  buyerUserId String
  slotStart   DateTime
  slotEnd     DateTime
  status      ViewingStatus @default(REQUESTED)

  property Property @relation(fields: [propertyId], references: [id])
  buyer    User     @relation(fields: [buyerUserId], references: [id])

  @@index([propertyId])
  @@index([buyerUserId])
}

model ChatMessage {
  id         String    @id @default(cuid())
  propertyId String
  fromUserId String
  toUserId   String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  from     User     @relation("SentMessages", fields: [fromUserId], references: [id])
  to       User     @relation("ReceivedMessages", fields: [toUserId], references: [id])

  @@index([propertyId])
  @@index([fromUserId])
  @@index([toUserId, readAt])
}

model Partner {
  id         String          @id @default(cuid())
  category   PartnerCategory
  name       String
  url        String
  logoUrl    String?
  approved   Boolean         @default(false)
  clickCount Int             @default(0)

  adSlots AdSlot[]
}

model AdSlot {
  id          String  @id @default(cuid())
  partnerId   String
  placement   String
  model       AdModel
  rateGBP     Int // pence
  active      Boolean @default(false)
  impressions Int     @default(0)
  clicks      Int     @default(0)

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

/// UK AML: retained 5 years — soft-delete only, survives user erasure (anonymised link).
model KycRecord {
  id                  String   @id @default(cuid())
  userId              String
  provider            String
  providerApplicantId String?
  status              String
  rawWebhookJson      Json?
  passportCountry     String?
  crn                 String?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Phase 4: Investor KYC submission (one per attempt). Transitions:
/// DRAFT (documents uploading) → SUBMITTED (investor confirms) →
/// APPROVED | REJECTED (Admin in Phase 5).
/// Financial KYC gating reads profiles.kycStatus, NOT this table.
model KycSubmission {
  id          String               @id @default(cuid())
  userId      String
  status      KycSubmissionStatus  @default(DRAFT)
  /// Investor's own declaration text — free form, required on submit.
  declaration String?
  submittedAt DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  /// Safe rejection reason visible to the Investor (Phase 5).
  rejectionReason  String?
  /// Admin-only confidential internal notes — NEVER exposed to Investor (Phase 5).
  internalNotes    String?
  /// Admin rejection reason legacy notes.
  reviewNotes      String?
  createdAt        DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  documents KycDocument[]

  @@index([userId, status])
  @@index([status, submittedAt])
}

/// Individual document uploaded within a KycSubmission.
/// storageKey is the private bucket key; the public URL is NEVER stored
/// — it must be generated server-side on demand with a signed URL.
model KycDocument {
  id           String          @id @default(cuid())
  submissionId String
  kind         KycDocumentKind
  /// Private bucket key, e.g. kyc/<userId>/<uuid>.pdf
  storageKey   String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime        @default(now())

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

/// Land Registry Price Paid ingest (Sprint 5).
model ComparableSale {
  id               String       @id @default(cuid())
  postcodeDistrict String
  address          String
  priceGBP         Int // pence
  soldDate         DateTime
  propertyType     PropertyType
  source           String       @default("LAND_REGISTRY")

  @@index([postcodeDistrict, soldDate])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entity      String
  entityId    String
  metaJson    Json?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entity, entityId])
  @@index([actorUserId])
}

enum FlipperOpportunityStatus {
  SAVED
  EVALUATING
  OFFER_SUBMITTED
  OFFER_ACCEPTED
  DECLINED
  WITHDRAWN
}

enum FlipperOfferStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum FlipperAcquisitionStatus {
  PENDING_COMPLETION
  COMPLETED
  CANCELLED
}

/// Phase 6: Property Flipper opportunity evaluation tracking.
model FlipperOpportunity {
  id             String                   @id @default(cuid())
  investorUserId String
  propertyId     String
  status         FlipperOpportunityStatus @default(SAVED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  investor User     @relation(fields: [investorUserId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  offers   FlipperOffer[]
  acquisitions FlipperAcquisition[]

  @@unique([investorUserId, propertyId])
  @@index([investorUserId, status])
  @@index([propertyId])
}

/// Phase 6: Property Flipper acquisition offer.
model FlipperOffer {
  id             String             @id @default(cuid())
  opportunityId String
  investorUserId String
  propertyId     String
  amountGBP      Int // pence
  status         FlipperOfferStatus @default(SUBMITTED)
  submittedAt    DateTime           @default(now())
  respondedAt    DateTime?
  agentNotes     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  opportunity FlipperOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  investor    User               @relation(fields: [investorUserId], references: [id])
  property    Property           @relation(fields: [propertyId], references: [id])
  acquisitions FlipperAcquisition[]

  @@index([opportunityId])
  @@index([investorUserId, status])
  @@index([propertyId, status])
}

/// Phase 6: Confirmed Flipper acquisition opportunity (handoff to Phase 7 Refurbishment).
model FlipperAcquisition {
  id             String                   @id @default(cuid())
  offerId        String                   @unique
  opportunityId String
  investorUserId String
  propertyId     String
  agreedPriceGBP Int // pence
  status         FlipperAcquisitionStatus @default(PENDING_COMPLETION)
  completedAt    DateTime?
  completedByUserId String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  offer       FlipperOffer       @relation(fields: [offerId], references: [id])
  opportunity FlipperOpportunity @relation(fields: [opportunityId], references: [id])
  investor    User               @relation(fields: [investorUserId], references: [id])
  property    Property           @relation(fields: [propertyId], references: [id])
  projects    FlipperProject[]

  @@index([investorUserId, status])
  @@index([propertyId])
}

enum FlipperProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum FlipperCostCategory {
  MATERIALS
  LABOUR
  PROFESSIONAL_FEES
  UTILITIES
  OTHER
}

enum FlipperMilestoneStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

/// Phase 7: Flipper refurbishment project tracking (unlocked after acquisition is COMPLETED).
model FlipperProject {
  id                   String               @id @default(cuid())
  acquisitionId        String               @unique
  investorUserId       String
  propertyId           String
  status               FlipperProjectStatus @default(PLANNING)
  plannedBudgetGBP     Int                  @default(0) // pence
  targetCompletionDate DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  acquisition FlipperAcquisition        @relation(fields: [acquisitionId], references: [id])
  investor    User                      @relation(fields: [investorUserId], references: [id])
  property    Property                  @relation(fields: [propertyId], references: [id])
  costs       FlipperProjectCost[]
  milestones  FlipperProjectMilestone[]
  resale      FlipperResale?

  @@index([investorUserId, status])
  @@index([propertyId])
}

/// Phase 7: Flipper project cost/expense ledger item.
model FlipperProjectCost {
  id          String              @id @default(cuid())
  projectId   String
  category    FlipperCostCategory @default(OTHER)
  description String
  amountGBP   Int // pence
  incurredAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project FlipperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
}

/// Phase 7: Flipper project milestone tracking.
model FlipperProjectMilestone {
  id          String                 @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      FlipperMilestoneStatus @default(TODO)
  targetDate  DateTime?
  completedAt DateTime?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project FlipperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// ─── Phase 8: Flipper Resale & Exit Workflow ──────────────────────────────────

/// Status lifecycle for Flipper resale listing.
/// DRAFT → SUBMITTED (by Investor) → APPROVED | REJECTED (by Admin only).
/// Investor can NEVER self-publish. LIVE is reached only via Admin approval.
enum FlipperResaleStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// Phase 8: Resale listing created by a Flipper investor after project completion.
/// The original FlipperProject is PRESERVED; this is a SEPARATE entity.
/// All financial figures labelled *Estimated* are non-guaranteed and advisory only.
/// Investor cannot transition to APPROVED directly; only Admin can.
model FlipperResale {
  id             String              @id @default(cuid())
  projectId      String              @unique
  investorUserId String
  propertyId     String

  /// Investor's estimated asking price for the renovated property (integer pence).
  estimatedAskingPriceGBP Int // pence — advisory, not guaranteed

  /// Investor's estimated profit margin (integer pence = estimated sale - total costs - acquisition price).
  /// Server-calculated from project data on submission; stored for audit trail.
  estimatedProfitGBP Int // pence — advisory

  /// Investor's resale listing description/pitch.
  description String?

  /// Investor's declaration confirming the listing information is accurate.
  declaration String?

  /// Admin-visible internal notes (NEVER exposed to Investor).
  internalNotes String?

  /// Safe reason shown to the Investor when the listing is rejected.
  rejectionReason String?

  status FlipperResaleStatus @default(DRAFT)

  resalePropertyId String?   @unique

  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        FlipperProject @relation(fields: [projectId], references: [id])
  investor       User           @relation(fields: [investorUserId], references: [id])
  property       Property       @relation(fields: [propertyId], references: [id])
  resaleProperty Property?      @relation("ResaleProperty", fields: [resalePropertyId], references: [id])

  @@index([investorUserId, status])
  @@index([status, submittedAt])
  @@index([propertyId])
}
