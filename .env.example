# ── Database (Supabase — human task H1.2) ─────────────────────────────
DATABASE_URL=                 # Supabase pooled connection string
DIRECT_URL=                   # Supabase direct connection (for migrations)

# ── Auth ──────────────────────────────────────────────────────────────
# Server-only HMAC secret for auth rate-limit identifiers and recovery grants.
# Generate at least 32 random bytes; never prefix this with NEXT_PUBLIC_.
AUTH_SECURITY_SECRET=
APP_ORIGIN=http://localhost:3000  # Exact staging origin; no path or wildcard
RATE_LIMIT_PROVIDER=memory       # mock/local only; use upstash in staging/prod
EMAIL_PROVIDER=mock              # mock locally; resend in staging/prod
EMAIL_FROM=PropLink UK <onboarding@resend.dev> # verified sender in staging/prod
TURNSTILE_PROVIDER=mock          # mock locally; cloudflare in staging/prod
TURNSTILE_ENABLED=false          # enable with real keys outside local development
TURNSTILE_SECRET_KEY=            # server-only Cloudflare Turnstile secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # public Cloudflare Turnstile site key
FINANCIAL_PROMOTIONS_REVIEWED=false
FLIPPER_FLOWS_ENABLED=false
UPLOADS_ENABLED=false            # disabled until a private quarantine and scanner are configured

# Supabase Auth public configuration. These values are safe to expose to the
# browser; authorization still depends on verified users and database RLS.
# Set PROPLINK_LOCAL_SUPABASE_PROJECT_REF to the approved development project
# reference; local development is blocked from staging.
PROPLINK_ENV=development
PROPLINK_LOCAL_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, SERVER-ONLY. Used by staging fixture scripts and, once the owner
# approves OD-18, by exactly one app module: agentAccountProvisioner.ts, which
# creates invited Agents' confirmed accounts (ADR-023). Leave empty until then:
# invites still send, acceptance fails closed. Never in client code or logs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage (AWS — human task H1.4/H2.1) ──────────────────────────────
# STORAGE_PROVIDER=mock|s3 — mock is local-only; production uploads require a
# separate quarantine bucket, private bucket and malware scanner.
STORAGE_PROVIDER=mock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET=
S3_QUARANTINE_BUCKET=
S3_PRIVATE_BUCKET=
CLOUDFRONT_URL=
MALWARE_SCANNER_PROVIDER=mock
MALWARE_SCANNER_URL=            # clamd: tcp://<host>:3310 (docs/credentials/malware-scanning.md)
MALWARE_SCANNER_TOKEN=

# ── Cache / rate limiting (Upstash — human task H1.5) ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI listing assistant (Phase 2 Task 2, docs/credentials/anthropic.md; human task H1.9) ──
AI_PROVIDER=mock                 # mock locally; anthropic in prod (prod refuses mock); or disabled
ANTHROPIC_API_KEY=               # server-only; required when AI_PROVIDER=anthropic
AI_MODEL=                        # optional; default claude-opus-5-5
AI_DAILY_TOKEN_BUDGET_PER_USER=  # optional; default 40000 tokens per user per UTC day
AI_GLOBAL_DAILY_BUDGET=          # optional; default 1000000 tokens per UTC day, all users

# ── Maps (Google — human tasks H2.2, H3.1) ────────────────────────────
GOOGLE_MAPS_API_KEY=          # browser key, referrer-restricted
GOOGLE_MAPS_SERVER_KEY=       # server key for Geocoding + Routes API

# ── KYC (Phase 1 Task 6, docs/credentials/kyc-provider.md; human tasks H1.10, H4.1) ──
KYC_PROVIDER=mock               # mock locally; sumsub in staging/prod (production refuses mock)
SUMSUB_APP_TOKEN=               # server-only; required when KYC_PROVIDER=sumsub
SUMSUB_SECRET_KEY=              # server-only; required when KYC_PROVIDER=sumsub
SUMSUB_WEBHOOK_SECRET=          # server-only; signs POST /api/webhooks/kyc
SUMSUB_LEVEL_NAME=              # optional; default basic-kyc-level

# ── Payments (Stripe — human task H5.1) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Realtime (Pusher — human task H4.2) ───────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# ── Email (Resend — human task H1.7) ──────────────────────────────────
RESEND_API_KEY=

# ── Gov data APIs (human task H1.10) ──────────────────────────────────
EPC_API_KEY=                  # EPC Register (free registration)
# Companies House (Phase 1 Task 4, docs/credentials/companies-house.md).
COMPANIES_HOUSE_PROVIDER=mock  # mock locally; companies_house in staging/prod (required in prod)
COMPANIES_HOUSE_API_KEY=       # server-only live REST key; required when the provider is companies_house

# ── Monitoring (Sentry — human task H1.8) ─────────────────────────────
SENTRY_DSN=                       # server-only Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=           # public browser Sentry DSN; scrubbed before send

# ── Feature flags (compliance-critical — see docs/ARCHITECTURE.md) ────
SYNDICATE_PAYMENTS_ENABLED=false
