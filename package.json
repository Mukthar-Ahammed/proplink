{
  "name": "proplink-uk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "node -e \"require('dotenv').config({ path: '.env.staging.local' }); process.env.NODE_ENV='development'; process.env.PROPLINK_ENV='staging'; require('child_process').spawnSync('next', ['dev'], { stdio: 'inherit', shell: true, env: process.env })\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-env": "node scripts/check-env.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:auth-phase4": "node scripts/test-phase4-auth.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:staging:status": "node scripts/assert-staging-db.mjs && node scripts/run-prisma-staging.mjs migrate status",
    "db:staging:inspect": "node scripts/inspect-staging-catalog.mjs",
    "db:staging:deploy:first": "node scripts/deploy-staging-first-migration.mjs",
    "db:staging:checkpoint": "node scripts/deploy-staging-checkpoint.mjs",
    "db:staging:validate:checkpoint1": "node scripts/validate-staging-checkpoint1.mjs",
    "db:staging:diagnose": "node scripts/diagnose-staging-migration.mjs",
    "phase3:provision": "node scripts/provision-phase3-fixtures.mjs",
    "phase3:reconcile": "node scripts/reconcile-phase3-fixtures.mjs",
    "phase3:cleanup": "node scripts/cleanup-phase3-fixtures.mjs",
    "db:staging:deploy": "node scripts/assert-staging-db.mjs && node -e \"if (process.env.CONFIRM_STAGING_MIGRATION !== 'yes') { console.error('Set CONFIRM_STAGING_MIGRATION=yes to authorize staging migration deployment.'); process.exit(1) }\" && node scripts/assert-staging-db.mjs && node scripts/run-prisma-staging.mjs migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "prepare": "node scripts/install-git-hooks.mjs",
    "format:check:changed": "node scripts/format-check-changed.mjs",
    "audit:check": "node scripts/audit-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-presigned-post": "^3.1101.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.64.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.101.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.4.5",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
