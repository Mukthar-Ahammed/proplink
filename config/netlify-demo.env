# Hosted client demo on Netlify (ADR-076). NON-SECRET switches only.
# Netlify → Site configuration → Environment variables → Import from a .env
# file, then paste this file. Scope: all; deploy contexts: all.
#
# Then add these by hand (secrets / per-site values; never commit them):
#   DATABASE_URL                           staging Supabase pooled URL (port 6543)
#   DIRECT_URL                             staging Supabase direct URL
#   NEXT_PUBLIC_SUPABASE_URL               https://jqmgfdjbfvcyivtquufn.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY   staging publishable key
#   AUTH_SECURITY_SECRET                   NEW 32+ random bytes, demo only
#   APP_ORIGIN                             https://<site>.netlify.app (no path)
#   SUPABASE_SERVICE_ROLE_KEY              optional: only for invite acceptance (OD-18)
# Mark the secrets "Contains secret values".

PROPLINK_ENV=demo
EMAIL_PROVIDER=mock
KYC_PROVIDER=mock
STRIPE_PROVIDER=mock
ESIGN_PROVIDER=mock
ESIGN_TEST_MODE=true
COMPANIES_HOUSE_PROVIDER=mock
AI_PROVIDER=mock
MAPS_PROVIDER=mock
TURNSTILE_PROVIDER=mock
TURNSTILE_ENABLED=false
RATE_LIMIT_PROVIDER=memory
STORAGE_PROVIDER=mock
MALWARE_SCANNER_PROVIDER=mock
